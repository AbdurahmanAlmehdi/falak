{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/edge.caddy.apply.schema.json",
  "title": "edge.caddy.apply \u2014 full desired route set; rendered to Caddy JSON and POSTed atomically to the admin API /load",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sites"
  ],
  "properties": {
    "acme_email": {
      "type": "string",
      "format": "email"
    },
    "acme_ca": {
      "type": "string",
      "format": "uri"
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domains",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable route id; becomes Caddy @id falak-site-<id>",
            "pattern": "^[a-z0-9-]+$"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(\\*\\.)?[a-z0-9.-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "redirect_domains": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            },
            "uniqueItems": true,
            "description": "Hosts that 308-redirect to domains[0]"
          },
          "tls": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "mode": {
                "enum": [
                  "acme",
                  "internal",
                  "custom",
                  "off",
                  "wildcard"
                ],
                "default": "acme",
                "description": "wildcard: served by one of the payload's wildcard_certificates (no certificate per host)"
              },
              "cert_name": {
                "type": "string",
                "description": "edge.cert.install name, when mode=custom"
              },
              "dns": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "api_token"
                ],
                "properties": {
                  "provider": {
                    "enum": [
                      "cloudflare"
                    ]
                  },
                  "api_token": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": "ACME DNS-01 challenge (required for wildcard domains when mode=acme); needs a Caddy/FrankenPHP build with the provider module"
              },
              "http_challenge_only": {
                "type": "boolean",
                "description": "ACME with HTTP-01 only (TLS-ALPN-01 disabled), for hosts behind a TLS-terminating proxy such as Cloudflare"
              }
            }
          },
          "kind": {
            "enum": [
              "frankenphp",
              "php_fpm",
              "reverse_proxy",
              "static",
              "redirect"
            ]
          },
          "root": {
            "type": "string",
            "pattern": "^/",
            "description": "Document root, e.g. /srv/falak/sites/shop/current/public. With kind=reverse_proxy (Laravel Octane): existing files under root are served directly (never *.php, dotfiles or directories) and everything else is proxied"
          },
          "php_fpm_socket": {
            "type": "string",
            "pattern": "^/"
          },
          "upstreams": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dial"
              ],
              "properties": {
                "dial": {
                  "type": "string",
                  "description": "host:port or unix//path",
                  "examples": [
                    "127.0.0.1:8080",
                    "unix//run/php/falak-shop-8.4.sock"
                  ]
                }
              }
            },
            "description": "reverse_proxy targets (also used for container/Node apps)"
          },
          "lb_policy": {
            "enum": [
              "round_robin",
              "least_conn",
              "first",
              "ip_hash"
            ],
            "default": "round_robin"
          },
          "health_uri": {
            "type": "string",
            "pattern": "^/"
          },
          "try_duration_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300,
            "default": 5,
            "description": "reverse_proxy: how long a request retries connecting to an upstream before failing (e.g. Octane restarting on deploy)"
          },
          "redirect_to": {
            "type": "string",
            "format": "uri",
            "description": "kind=redirect target"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Response headers to set"
          },
          "request_headers": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z0-9-]{1,64}$"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "kind=reverse_proxy: headers set on the request sent upstream (functions: X-Falak-Function)"
          },
          "mounts": {
            "type": "array",
            "maxItems": 20,
            "description": "Paths of this site sent to another upstream (agent feature fn.v2): a function through the local gateway (127.0.0.1:7070 + X-Falak-Function) or its own domain over HTTPS (tls_server_name). Each matches <path_prefix> and <path_prefix>/*, longest first, after the site's access rules and before its redirects and handler.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path_prefix",
                "dial"
              ],
              "properties": {
                "path_prefix": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 200,
                  "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*[^/]$"
                },
                "strip_prefix": {
                  "type": "boolean",
                  "default": false
                },
                "dial": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 300
                },
                "tls_server_name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9.-]{1,253}$"
                },
                "request_headers": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Za-z0-9-]{1,64}$"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "basic_auth": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "username",
                "password_hash"
              ],
              "properties": {
                "username": {
                  "type": "string"
                },
                "password_hash": {
                  "type": "string",
                  "description": "bcrypt hash"
                },
                "path": {
                  "type": "string",
                  "pattern": "^/",
                  "description": "Caddy path matcher (e.g. /admin/*); omitted = whole site"
                }
              }
            }
          },
          "redirects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^/"
                },
                "to": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    301,
                    302,
                    307,
                    308
                  ],
                  "default": 301
                }
              }
            }
          },
          "deny_ips": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "CIDR"
            }
          },
          "allow_ips": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "CIDR; when set, everything else is denied"
            }
          },
          "max_body_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "encode": {
            "type": "boolean",
            "default": true,
            "description": "gzip + zstd"
          },
          "access_log": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "description": "Site slug: HTTP access log of the route's hosts written as Caddy JSON to /var/log/falak/access/<access_log>.log (rotated at 10 MB), shipped by the agent to Loki as kind=access records of that site. Routes of one site share it"
          },
          "rate_limits": {
            "type": "array",
            "maxItems": 20,
            "description": "Feature edge.rate_limit: requests per client IP on paths of the site (the rate_limit module of Falak's Caddy build); more get 429. Absent for sites without rules (their routes render unchanged)",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "events",
                "window_s"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^/[A-Za-z0-9._~!$&'()+,;=:@%/-]{0,198}\\*?$",
                  "description": "Request path; a trailing * matches a prefix"
                },
                "events": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "window_s": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                }
              }
            }
          }
        }
      }
    },
    "raw": {
      "type": "object",
      "description": "Escape hatch: complete Caddy JSON config; when present it is loaded verbatim and `sites` is ignored"
    },
    "request_id": {
      "type": "boolean",
      "description": "Feature edge.request_id: every site's requests get an X-Request-Id (a well-formed incoming one, ^[A-Za-z0-9._:-]{8,128}$, is kept; else a UUID), passed upstream, echoed in the response and recorded in the access log (http.request.id). Absent or false: the config renders as without the feature"
    },
    "trusted_proxies": {
      "type": "array",
      "description": "CIDRs whose CF-Connecting-IP header is trusted for the client IP (Cloudflare's ranges for proxied sites)",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 200
    },
    "wildcard_certificates": {
      "type": "array",
      "description": "Wildcard certificates the edge obtains and renews through ACME DNS-01 (preview domains): sites in tls mode wildcard are served by the one covering their hosts",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "dns"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^\\*\\.[a-z0-9-]+(\\.[a-z0-9-]+)+$"
          },
          "dns": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "api_token"
            ],
            "properties": {
              "provider": {
                "enum": [
                  "cloudflare"
                ]
              },
              "api_token": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "caddy_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256"
      ],
      "description": "Features edge.rate_limit, edge.caddy_dns: Falak's Caddy build (Caddy + caddy-ratelimit + caddy-dns/cloudflare) for the server's architecture, only sent with rate limits or DNS-01 certificates; installed when the edge's Caddy lacks a module the config uses",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "config_sha256"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "routes": {
          "type": "integer"
        },
        "rate_limits_refused": {
          "type": "string",
          "maxLength": 1000,
          "description": "Features edge.rate_limit, edge.caddy_dns: why the payload's rate limits were left out of the applied config and its DNS-01 certificates obtained over HTTP-01 instead (no module and no usable build, a FrankenPHP edge, a build that failed here); the rest of the config is applied"
        }
      }
    }
  }
}
