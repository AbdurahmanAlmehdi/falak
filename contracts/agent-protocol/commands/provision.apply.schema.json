{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/provision.apply.schema.json",
  "title": "provision.apply — declarative provisioning plan (full desired state; converges)",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "hostname": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "timezone": {
      "type": "string",
      "default": "UTC",
      "examples": [
        "UTC",
        "Europe/Amsterdam"
      ]
    },
    "swap_mb": {
      "type": "integer",
      "minimum": 0,
      "description": "0 = no swapfile managed"
    },
    "apt": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]*(=[A-Za-z0-9.+:~-]+)?$",
            "description": "apt package name, optionally pinned with =version"
          },
          "uniqueItems": true
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]*(=[A-Za-z0-9.+:~-]+)?$",
            "description": "apt package name, optionally pinned with =version"
          },
          "uniqueItems": true
        }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
          },
          "uid": {
            "type": "integer",
            "minimum": 0
          },
          "shell": {
            "type": "string",
            "default": "/bin/bash"
          },
          "home": {
            "type": "string",
            "pattern": "^/"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
              "not": {
                "enum": ["docker"]
              }
            },
            "uniqueItems": true,
            "description": "Supplementary groups (created if missing). Never docker: its socket is root on the server; the agent takes users out of it."
          },
          "system": {
            "type": "boolean",
            "default": false
          },
          "sudo": {
            "enum": [
              "none",
              "nopasswd"
            ],
            "default": "none",
            "description": "Writes/removes /etc/sudoers.d/falak-<name>"
          },
          "isolated": {
            "type": "boolean",
            "default": false,
            "description": "Home dir mode 0750 so other site users cannot read it"
          }
        }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "php": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "versions"
          ],
          "properties": {
            "versions": {
              "type": "array",
              "items": {
                "enum": [
                  "7.4",
                  "8.0",
                  "8.1",
                  "8.2",
                  "8.3",
                  "8.4",
                  "8.5"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "enum": [
                "7.4",
                "8.0",
                "8.1",
                "8.2",
                "8.3",
                "8.4",
                "8.5"
              ]
            },
            "extensions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "uniqueItems": true,
              "description": "e.g. mbstring, intl, redis (installed as php<v>-<ext>)"
            },
            "fpm": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "frankenphp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mirror": {
              "type": "string",
              "format": "uri",
              "default": "https://github.com/php/frankenphp/releases/download",
              "description": "Release download base: <mirror>/v<version>/frankenphp-linux-<arch>-gnu (an HTTPS mirror or caching proxy of GitHub releases)"
            }
          }
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "versions"
          ],
          "properties": {
            "versions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "type": "string"
            },
            "mirror": {
              "type": "string",
              "format": "uri",
              "default": "https://nodejs.org/dist",
              "description": "nodejs.org/dist mirror used for every version (see runtime.node.install)"
            }
          }
        },
        "caddy": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "version": {
              "type": "string",
              "description": "Omit for the apt repo's latest"
            }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9@._-]+$"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "state": {
            "enum": [
              "started",
              "stopped",
              "restarted"
            ],
            "default": "started"
          }
        }
      }
    },
    "unattended_upgrades": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "auto_reboot": {
          "type": "boolean",
          "default": false
        },
        "reboot_time": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$",
          "default": "04:00"
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "permit_root_login": {
          "enum": [
            "no",
            "prohibit-password"
          ],
          "default": "prohibit-password"
        },
        "password_authentication": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "components": {
      "type": "array",
      "description": "Machine-check decisions (feature provision.v2). The plan already reflects them (adopted engines have no apt packages, an adopted swap / hostname has no swap_mb / hostname); the agent additionally never installs an adopted component's packages, verifies them in an adopt:<name> step, keeps an adopted swap and hostname, and writes no unattended-upgrades config when that is adopted.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "decision"
        ],
        "properties": {
          "name": {
            "enum": [
              "base",
              "docker",
              "edge",
              "php",
              "node",
              "ssh",
              "firewall",
              "swap",
              "hostname",
              "unattended_upgrades",
              "fail2ban"
            ]
          },
          "decision": {
            "enum": [
              "install",
              "adopt",
              "complete"
            ],
            "description": "install: nothing there; adopt: a compatible one is there (use it, never install); complete: only the missing pieces are in apt.packages"
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9+.-]*$"
            },
            "uniqueItems": true,
            "description": "adopt: the installed packages that make up the component (verified, never installed); complete: the packages being added"
          },
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9@._-]+$",
            "description": "The component's systemd service (enabled and started through services)"
          }
        }
      }
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "live_restore": {
          "type": "boolean",
          "default": false,
          "description": "merge \"live-restore\": true into /etc/docker/daemon.json (other keys kept; invalid JSON fails the step) and reload dockerd: containers (databases) keep running while the daemon restarts or is upgraded"
        },
        "min_version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*$",
          "description": "Docker Engine this version or newer. A Docker already that recent stays; otherwise docker-ce, docker-ce-cli, containerd.io, docker-buildx-plugin and docker-compose-plugin come from Docker's apt repository (key fingerprint checked, signed-by keyring), replacing the distribution's docker.io (containers, images and volumes stay). Where Docker's repository has no suite for the release yet, the distribution's docker.io if it is this recent, else the step fails. Skipped when the docker component is adopted"
        }
      },
      "description": "Docker Engine and daemon settings (feature db.instances). Every server runs Docker; its service comes through services."
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "steps"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "changed"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "changed": {
                "type": "boolean"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
