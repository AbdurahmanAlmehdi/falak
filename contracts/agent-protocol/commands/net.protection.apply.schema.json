{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/net.protection.apply.schema.json",
  "title": "net.protection.apply — the server's blocked addresses (nftables sets falak_block4 / falak_block6 with timeouts in table inet falak_protect, dropped at prerouting) and auto-ban settings; full desired state, applied element by element (docs/plans/network/protection.md). Feature net.protection.",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocks"
  ],
  "properties": {
    "blocks": {
      "type": "array",
      "maxItems": 10000,
      "description": "Active blocks: the server's own, the organization-wide ones and its auto-bans",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cidr"
        ],
        "properties": {
          "cidr": {
            "type": "string",
            "maxLength": 43,
            "pattern": "^[0-9a-fA-F.:]+(/[0-9]{1,3})?$",
            "description": "IPv4 / IPv6 address or canonical CIDR (no host bits); at least /8 (IPv4) or /16 (IPv6)"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "null = permanent; the element gets the remaining time as its nftables timeout"
          }
        }
      }
    },
    "release": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "maxLength": 43,
        "pattern": "^[0-9a-fA-F.:]+(/[0-9]{1,3})?$"
      },
      "description": "Auto-bans a user lifted: forgotten from the agent's own state"
    },
    "never_block": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "string",
        "maxLength": 43,
        "pattern": "^[0-9a-fA-F.:]+(/[0-9]{1,3})?$"
      },
      "description": "Protected addresses and ranges (control plane, the organization's servers, WireGuard): no element may overlap them"
    },
    "auto_ban": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failures": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "window_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "ban_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when elements were added or removed"
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "error"
            ],
            "properties": {
              "cidr": {
                "type": "string"
              },
              "error": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "set_counters": {
          "type": "boolean",
          "description": "false when the host refused per-element counters (no hits per block)"
        }
      }
    }
  }
}
