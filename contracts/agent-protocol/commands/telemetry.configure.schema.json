{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/telemetry.configure.schema.json",
  "title": "telemetry.configure — OTLP relay configuration (persisted to /etc/falak/telemetry.json, hot reloaded)",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "endpoint": {
      "type": "string",
      "format": "uri",
      "description": "OTLP/HTTP base URL; overrides endpoints.otlp from enrollment"
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "org_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID"
        },
        "server_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID"
        },
        "environment": {
          "type": "string",
          "default": "production"
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "traces_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "site_id"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "description": "Site slug (directory name under /srv/falak/sites)"
          },
          "site_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "description": "ULID"
          },
          "environment": {
            "type": "string"
          },
          "deployment_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "description": "ULID"
          },
          "release_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "description": "ULID"
          },
          "unix_user": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
            "description": "The site's own unix user (isolated sites only; a user several sites share is never sent, and the agent skips one claimed by several sites). A native site without a cgroup slice (falak-site_<slug>.slice) is measured as the sum of the processes this user owns (falak.workload.kind=user)"
          },
          "runtime": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "description": "The site's runtime: frankenphp, php-fpm, node, bun, deno, static, docker, compose or function. Container runtimes (docker, compose, function) are measured from their labelled containers and need no per-user collector"
          }
        }
      }
    },
    "log_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/",
            "description": "File path or glob"
          },
          "service": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "description": "Site slug (directory name under /srv/falak/sites)"
          },
          "format": {
            "enum": [
              "plain",
              "json"
            ],
            "default": "plain"
          },
          "kind": {
            "enum": [
              "app",
              "access"
            ],
            "default": "app",
            "description": "falak.log.kind resource attribute (Loki label falak_log_kind). The edge access logs (/var/log/falak/access/<slug>.log) are always tailed as kind access; they need no entry here"
          },
          "multiline": {
            "enum": [
              "laravel"
            ],
            "description": "Merge continuation lines into the preceding record. laravel: records start with \"[YYYY-MM-DD HH:MM:SS\" (Monolog line format), so stack traces stay with their error"
          }
        }
      }
    },
    "docker_logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "label_selector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interval_s": {
          "type": "integer",
          "minimum": 5,
          "default": 15
        }
      }
    },
    "insights": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "buffer_max_bytes": {
      "type": "integer",
      "minimum": 0,
      "default": 67108864
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        }
      }
    }
  }
}
