#!/usr/bin/env bash
# falak-ctl — operate a Falak install (Docker Compose stack in /opt/falak, created by install.sh).
#
#   falak-ctl status                        containers, health, version, URLs, PHP thread usage
#   falak-ctl logs [service] [-f]           recent logs (all services, or one)
#   falak-ctl up | down | restart [svc]     start / stop / restart the stack
#   falak-ctl update [--version vX.Y.Z]     backup -> pull -> migrate -> restart -> health check,
#                                           automatic rollback (previous version + DB restore) on failure,
#                                           then removes Falak images older than the previous version
#   falak-ctl prune-images [--dry-run]      remove Falak images except the current and previous version
#   falak-ctl backup [--label NAME] [--upload] [--include-registry]
#                                           Postgres dump + app storage + Fleet CA + edge PKI + .env -> backups/
#                                           (+ the KEK, only when the DR passphrase encrypts the backup);
#                                           --upload: to the DR bucket (encrypted only), failing when it can't
#   falak-ctl restore <file | s3://latest | s3://NAME> [--yes] [--force]
#                                           restore a backup (stops the app while restoring); s3:// downloads an
#                                           authenticated backup (.fdr) and checks it with the DR passphrase first
#   falak-ctl dr setup [options]            disaster recovery: DR bucket, passphrase, backup + drill timers
#   falak-ctl dr status [--json]            last backup, its age and size, last drill, configured or not
#   falak-ctl dr drill [--local]            restore the latest backup into a throwaway stack (falak-drill), check it
#   falak-ctl doctor                        DNS, certificates, ports, disk, containers, agent API, PHP threads, KEK
#   falak-ctl kek init | status             key-encryption key (secrets/kek): create if missing, fix permissions / check
#   falak-ctl kek export <file>             write the emergency kit (the KEK) to a file you keep offline
#   falak-ctl kek import <file> [--force]   put the KEK back from an emergency kit
#   falak-ctl kek rotate                    new KEK; data keys are re-wrapped, the old KEK stays for older backups
#   falak-ctl domain set <domain> [--keep-old]  move the panel to a new domain
#   falak-ctl registry status | prune [--dry-run] | gc [--dry-run] [--force]
#                                           built-in image registry: address and size / delete unneeded images /
#                                           garbage-collect (weekly from /etc/cron.d/falak-registry-gc)
#   falak-ctl admin reset-password <email> [--password=...]
#   falak-ctl admin create <email>
#   falak-ctl artisan <args...>             run php artisan in the control-plane container
#   falak-ctl compose <args...>             raw docker compose with the install's settings
#   falak-ctl reload-configs                recreate services whose mounted config files changed on disk
#   falak-ctl local-server enable --install-url URL | disable | status | allow | deny
#                                           sites on this machine: enrol its agent, the edge passes it every host the
#                                           panel does not serve; the panel keeps FALAK_CP_RESERVE_MB and one core.
#                                           allow/deny: whether the panel may ask for it (This machine)
#   falak-ctl panel-access tailnet | public | status
#                                           panel (browser paths) only over the Tailscale tailnet / from anywhere
#   falak-ctl ensure-host                   (re)write the host units (falak-host.path) and resource slices
#   falak-ctl host-run                      run the panel's host request (falak-host.service; update, local-server)
#   falak-ctl version
#
# Environment: FALAK_DIR (default /opt/falak), FALAK_PROJECT (compose project, default falak).
# Settings are read from $FALAK_DIR/.env (see docs/INSTALL.md); the DR bucket and passphrase from $FALAK_DIR/dr/dr.env
# (root only, see docs/DISASTER_RECOVERY.md).
set -euo pipefail

FALAK_DIR="${FALAK_DIR:-/opt/falak}"
FALAK_PROJECT="${FALAK_PROJECT:-falak}"
ENV_FILE="$FALAK_DIR/.env"
COMPOSE_FILE="$FALAK_DIR/deploy/compose.yml"
BACKUP_DIR="$FALAK_DIR/backups"
APP_SERVICES="control-plane agent-api horizon reverb scheduler relay builder"
PHP_SERVICES="control-plane agent-api horizon reverb scheduler"
FALAK_REPO_DEFAULT="falak-sh/falak"
# Disaster recovery: the DR bucket's credentials and the passphrase live in dr/dr.env (dir 0700, file 0600, root;
# never mounted into a container, never in a backup). What the panel shows is in state/dr.json (no secrets), mounted
# read-only into the PHP containers.
DR_DIR="$FALAK_DIR/dr"
DR_FILE="$DR_DIR/dr.env"
STATE_DIR="$FALAK_DIR/state"
DR_STATE="$STATE_DIR/dr.state"
DR_JSON="$STATE_DIR/dr.json"
TMP_LIST=""
# shellcheck disable=SC2086  # mktemp paths, space-separated
cleanup() { [ -z "$TMP_LIST" ] || rm -rf $TMP_LIST; }
trap cleanup EXIT
tmpdir() { local d; d="$(mktemp -d "${1:-${TMPDIR:-/tmp}}/.falak.XXXXXX")"; TMP_LIST="$TMP_LIST $d"; echo "$d"; }

# --- output -----------------------------------------------------------------------------------------
if [ -t 1 ]; then B=$'\e[1m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; N=$'\e[0m'; else B=; R=; G=; Y=; N=; fi
say()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*" >&2; }
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# --- .env helpers -----------------------------------------------------------------------------------
env_get() { # env_get KEY [default]
  local v
  v="$(grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  v="${v%\"}"; v="${v#\"}"
  printf '%s' "${v:-${2:-}}"
}

env_set() { # env_set KEY VALUE  (atomic, keeps mode 600)
  local tmp
  tmp="$(mktemp "$FALAK_DIR/.env.XXXXXX")"
  chmod 600 "$tmp"
  if grep -qE "^$1=" "$ENV_FILE" 2>/dev/null; then
    awk -v k="$1" -v v="$2" 'BEGIN { FS = OFS = "=" } $1 == k { print k "=" v; next } { print }' "$ENV_FILE" > "$tmp"
  else
    { cat "$ENV_FILE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } > "$tmp"
  fi
  mv "$tmp" "$ENV_FILE"
}

require_install() {
  [ -f "$ENV_FILE" ] || die "no Falak install at $FALAK_DIR (missing .env). Run install.sh first, or set FALAK_DIR."
  [ -f "$COMPOSE_FILE" ] || die "missing $COMPOSE_FILE"
  command -v docker >/dev/null || die "docker is not installed"
}

compose() {
  COMPOSE_PROFILES="$(env_get COMPOSE_PROFILES)" \
    docker compose -p "$FALAK_PROJECT" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

running_services() { compose ps --services --status running 2>/dev/null || true; }

is_running() { running_services | grep -qx "$1"; }

# Utility container for volume access: the postgres image is always present locally.
util_image() { echo "postgres:17.11"; }
volume() { echo "${FALAK_PROJECT}_$1"; }

https_port() { env_get FALAK_HTTPS_PORT 443; }

rand_hex() { od -An -tx1 -N"$1" /dev/urandom | tr -d ' \n'; }

# curl through the local edge, resolving the public names to 127.0.0.1 (works before DNS, avoids hairpin).
edge_curl() { # edge_curl HOST PATH [curl args...]
  local host="$1" path="$2"; shift 2
  local port; port="$(https_port)"
  local tls=()
  [ "$(env_get FALAK_TLS acme)" = "internal" ] && tls=(-k)
  curl -sS --max-time 15 "${tls[@]}" --resolve "$host:$port:127.0.0.1" "$@" "https://$host:$port$path"
}

# --- built-in image registry ------------------------------------------------------------------------
# Docker builds push to registry.<domain> and servers pull from it (basic auth at the edge). Installs that
# predate it get its settings here, from every command that (re)starts the stack.
ensure_registry_env() {
  local domain host port suffix
  domain="$(env_get FALAK_DOMAIN)"
  [ -n "$domain" ] || return 0
  host="$(env_get FALAK_REGISTRY_HOST)"
  if [ -z "$host" ]; then
    host="registry.$domain"
    port="$(https_port)"; suffix=""; [ "$port" != 443 ] && suffix=":$port"
    env_set FALAK_REGISTRY_HOST "$host"
    env_set FALAK_REGISTRY_URL "$host$suffix"
    info "built-in image registry: https://$host$suffix"
    say "  Add a DNS record for $host pointing at this host (like $(env_get FALAK_AGENT_API_HOST)); docker builds push there."
  fi
  [ -n "$(env_get FALAK_REGISTRY_USERNAME)" ] || env_set FALAK_REGISTRY_USERNAME falak
  [ -n "$(env_get FALAK_REGISTRY_PASSWORD)" ] || env_set FALAK_REGISTRY_PASSWORD "$(rand_hex 24)"
  ensure_registry_gc_schedule
  return 0
}

# The control plane deletes unneeded images daily (falak:registry-prune); their layers only free disk space once the
# registry garbage-collects, which needs it stopped for a moment: weekly, Sunday night, from cron.
# FALAK_REGISTRY_GC=0 turns it off (the file is removed).
ensure_registry_gc_schedule() {
  local dir="${FALAK_CRON_DIR:-/etc/cron.d}" file ctl line
  file="$dir/falak-registry-gc"
  if [ "$(env_get FALAK_REGISTRY_GC)" = 0 ]; then
    [ -f "$file" ] && rm -f "$file" && info "weekly registry garbage collection turned off"
    return 0
  fi
  [ -d "$dir" ] && [ -w "$dir" ] || return 0
  ctl="$(command -v falak-ctl 2>/dev/null || echo /usr/local/bin/falak-ctl)"
  line="17 4 * * 0 root FALAK_DIR=$FALAK_DIR $ctl registry gc >> /var/log/falak-registry-gc.log 2>&1"
  if [ "$(grep -v '^#' "$file" 2>/dev/null)" != "$line" ]; then
    printf '# Falak: weekly garbage collection of the built-in image registry (falak-ctl registry gc).\n%s\n' "$line" > "$file"
    chmod 644 "$file"
  fi
}

# --- key-encryption key (KEK) ---------------------------------------------------------------------------
# Every secret in the database is sealed with data keys that are wrapped by the KEK: 32 random bytes in
# $FALAK_DIR/secrets/kek, never in .env or the database, mounted read-only into the PHP containers. The container
# runs as www-data (uid 33): the file is 0400 and owned by it, its directory 0711 (no listing). Losing the KEK
# makes every secret unreadable, so `kek export` writes an emergency kit to keep offline.
# FALAK_KEK_PROVIDER=aws-kms | vault-transit keeps the KEK in KMS / Vault instead (no file).
SECRETS_DIR="$FALAK_DIR/secrets"
KEK_FILE="$SECRETS_DIR/kek"
KEK_PREVIOUS="$SECRETS_DIR/kek.previous"
KEK_SIZE=32

kek_provider() { env_get FALAK_KEK_PROVIDER local; }
app_uid() { printf '%s' "${FALAK_APP_UID:-33}"; }

file_size() { wc -c < "$1" | tr -d ' '; }
file_mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }
file_uid() { stat -c %u "$1" 2>/dev/null || stat -f %u "$1"; }
sha256_hex() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }

kek_fingerprint() { # kek_fingerprint FILE -> the KEK id the control plane records (sha256("falak-kek-id:" || key), 16 hex)
  { printf 'falak-kek-id:'; cat "$1"; } | sha256_hex | cut -c1-16
}

kek_secure() { # kek_secure FILE : 0400, owned by the container's www-data (when we can chown)
  chmod 0400 "$1"
  chown "$(app_uid):$(app_uid)" "$1" 2>/dev/null || [ "$(id -u)" != 0 ] || warn "could not chown $1 to uid $(app_uid)"
}

kek_write_new() { # kek_write_new FILE : 32 bytes from /dev/urandom, never replacing an existing file
  local tmp
  tmp="$(mktemp "$SECRETS_DIR/.kek.XXXXXX")"
  head -c "$KEK_SIZE" /dev/urandom > "$tmp"
  [ "$(file_size "$tmp")" = "$KEK_SIZE" ] || { rm -f "$tmp"; die "could not read $KEK_SIZE bytes from /dev/urandom"; }
  kek_secure "$tmp"
  ln "$tmp" "$1" 2>/dev/null || { rm -f "$tmp"; die "$1 already exists"; }
  rm -f "$tmp"
}

# Create the KEK when missing (install, and updates from releases before it existed); fix its permissions.
# Never replaces one: a wrong-size file stops here instead.
ensure_kek() { # ensure_kek [--quiet]
  [ "$(kek_provider)" = local ] || return 0
  install -d -m 0711 "$SECRETS_DIR"
  chmod 0711 "$SECRETS_DIR"
  if [ ! -e "$KEK_FILE" ]; then
    kek_write_new "$KEK_FILE"
    info "created the key-encryption key $KEK_FILE (id $(kek_fingerprint "$KEK_FILE"))"
    say "  Without it the secrets in the database and in backups can't be decrypted. Keep a copy off this host:"
    say "    falak-ctl kek export /root/falak-emergency-kit.txt   (then move it to a password manager or offline storage)"
  fi
  [ -f "$KEK_FILE" ] || die "$KEK_FILE is not a file (a directory created by Docker?). Remove it, then put the KEK back (falak-ctl kek import <kit>)"
  [ "$(file_size "$KEK_FILE")" = "$KEK_SIZE" ] || die "$KEK_FILE must be exactly $KEK_SIZE bytes (it has $(file_size "$KEK_FILE")); restore it from the emergency kit (falak-ctl kek import <kit>)"
  kek_secure "$KEK_FILE"
  if [ -f "$KEK_PREVIOUS" ]; then kek_secure "$KEK_PREVIOUS"; fi
  [ "${1:-}" = --quiet ] || ok "key-encryption key $(kek_fingerprint "$KEK_FILE")"
}

cmd_kek() {
  require_install
  local sub="${1:-}"; shift || true
  case "$sub" in
    init) ensure_kek ;;
    status) kek_status ;;
    export) kek_export "$@" ;;
    import) kek_import "$@" ;;
    rotate) kek_rotate "$@" ;;
    *) die "usage: falak-ctl kek init | status | export <file> | import <file> [--force] | rotate" ;;
  esac
}

kek_status() { # problems are counted by the caller (doctor) from the return code
  local problems=0 provider mode
  provider="$(kek_provider)"
  if [ "$provider" != local ]; then
    ok "key-encryption key held by $provider"
  elif [ ! -f "$KEK_FILE" ]; then
    bad "$KEK_FILE is missing: the control plane can't start (falak-ctl kek import <kit>, or falak-ctl kek init on a new install)"
    return 1
  else
    mode="$(file_mode "$KEK_FILE")"
    if [ "$(file_size "$KEK_FILE")" != "$KEK_SIZE" ]; then bad "$KEK_FILE has $(file_size "$KEK_FILE") bytes (expected $KEK_SIZE)"; problems=$((problems + 1))
    elif [ "$mode" != 400 ] && [ "$mode" != 600 ]; then bad "$KEK_FILE has mode $mode (expected 400): falak-ctl kek init fixes it"; problems=$((problems + 1))
    elif [ "$(file_uid "$KEK_FILE")" != "$(app_uid)" ]; then bad "$KEK_FILE is owned by uid $(file_uid "$KEK_FILE"), not the container's www-data ($(app_uid)): falak-ctl kek init fixes it"; problems=$((problems + 1))
    else ok "key-encryption key $KEK_FILE (id $(kek_fingerprint "$KEK_FILE"), mode $mode)"
    fi
    [ -f "$KEK_PREVIOUS" ] && say "  previous KEK kept for older backups: $KEK_PREVIOUS (id $(kek_fingerprint "$KEK_PREVIOUS"))"
  fi
  if is_running control-plane; then
    if compose exec -T control-plane php artisan falak:keys:check --no-interaction >/dev/null 2>&1; then
      ok "the control plane unwraps every data key with it"
    else
      bad "falak:keys:check failed: falak-ctl artisan falak:keys:check"; problems=$((problems + 1))
    fi
  fi
  [ "$problems" = 0 ]
}

# The emergency kit: the KEK (base64) with what it is for and how to put it back. Written to a file the admin
# names, mode 0600, never over an existing file and never to stdout.
kek_export() {
  local out="${1:-}"
  if [ -z "$out" ] || [ "$out" = - ]; then
    say "usage: falak-ctl kek export <file>"
    say
    say "Writes the emergency kit: the key-encryption key that protects every secret in Falak's database and backups."
    say "Store the file offline or in a password manager, apart from the backups, then delete it from this host."
    exit 2
  fi
  [ ! -e "$out" ] || die "$out exists; choose a new file"
  local provider; provider="$(kek_provider)"
  local tmp
  tmp="$(mktemp "$(dirname "$out")/.falak-kit.XXXXXX")" || die "cannot write in $(dirname "$out")"
  chmod 600 "$tmp"
  {
    echo "FALAK EMERGENCY KIT: key-encryption key (KEK)"
    echo
    echo "Install:   $(env_get FALAK_DOMAIN)"
    echo "Created:   $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "Provider:  $provider"
    if [ "$provider" = local ]; then
      echo "KEK id:    $(kek_fingerprint "$KEK_FILE")"
      echo
      echo "Every secret Falak stores (environment variables, database passwords, keys, tokens) is encrypted under this"
      echo "key. A database backup is useless without it. Keep this file offline or in a password manager, apart from"
      echo "the backups, and delete it from the server once it is stored."
      echo
      echo "Put it back (a new host, or a lost $KEK_FILE):"
      echo "    falak-ctl kek import <this file>"
      echo
      echo "-----BEGIN FALAK KEK-----"
      base64 < "$KEK_FILE" | tr -d '\n'; echo
      echo "-----END FALAK KEK-----"
    else
      echo
      echo "The KEK never leaves $provider; this kit holds no key material. Keep access to that key (and its"
      echo "FALAK_KEK_* settings in custom.env): without it the secrets in the database can't be decrypted."
    fi
  } > "$tmp"
  ln "$tmp" "$out" 2>/dev/null || { rm -f "$tmp"; die "$out exists; choose a new file"; }
  rm -f "$tmp"
  ok "wrote $out (mode 600). Move it off this host, then delete it here."
}

kek_import() { # kek_import KIT [--force] : the KEK from an emergency kit; --force replaces a different KEK (kept aside)
  local kit="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in --force) force=1 ;; -*) die "kek import: unknown option $1" ;; *) kit="$1" ;; esac
    shift
  done
  if [ -z "$kit" ] || [ ! -f "$kit" ]; then die "usage: falak-ctl kek import <emergency kit file> [--force]"; fi
  [ "$(kek_provider)" = local ] || die "FALAK_KEK_PROVIDER is $(kek_provider): there is no KEK file to import"
  install -d -m 0711 "$SECRETS_DIR"
  local tmp
  tmp="$(mktemp "$SECRETS_DIR/.kek.XXXXXX")"
  sed -n '/^-----BEGIN FALAK KEK-----$/,/^-----END FALAK KEK-----$/p' "$kit" | sed '1d;$d' | tr -d ' \r\n' | base64 -d > "$tmp" 2>/dev/null || true
  if [ "$(file_size "$tmp")" != "$KEK_SIZE" ]; then rm -f "$tmp"; die "$kit holds no valid KEK (expected a FALAK KEK block of $KEK_SIZE bytes)"; fi
  local id; id="$(kek_fingerprint "$tmp")"
  if grep -q '^KEK id:' "$kit" && ! grep -q "^KEK id: *$id\$" "$kit"; then rm -f "$tmp"; die "$kit: the key does not match its KEK id (damaged copy?)"; fi
  if [ -f "$KEK_FILE" ]; then
    if [ "$(kek_fingerprint "$KEK_FILE")" = "$id" ]; then rm -f "$tmp"; ensure_kek; return 0; fi
    [ "$force" = 1 ] || { rm -f "$tmp"; die "$KEK_FILE holds another KEK ($(kek_fingerprint "$KEK_FILE")); --force replaces it (it is kept as $KEK_FILE.replaced-<time>)"; }
    mv "$KEK_FILE" "$KEK_FILE.replaced-$(date -u +%Y%m%dT%H%M%SZ)"
  fi
  kek_secure "$tmp"
  mv "$tmp" "$KEK_FILE"
  ok "imported KEK $id into $KEK_FILE"
  if is_running control-plane; then say "  Restart the control plane to use it: falak-ctl up"; fi
}

# falak:keys:check --json in the running control plane: one line, e.g.
#   {"ok":true,"provider":"local","kek_id":"…","data_keys":3,"stale":0,"failed":0,"kek_ids":["…"]}
# Fails (non-zero) when a data key doesn't unwrap or the control plane isn't running.
keys_check_json() {
  compose exec -T control-plane php artisan falak:keys:check --json --no-interaction 2>/dev/null | tail -1
}

json_number() { # json_number KEY JSON -> the number, or nothing
  printf '%s' "$2" | sed -n "s/.*\"$1\":\([0-9][0-9]*\).*/\1/p"
}

json_kek_ids() { # json_kek_ids JSON -> the kek_ids array, comma-separated
  printf '%s' "$1" | sed -n 's/.*"kek_ids":\[\([^]]*\)\].*/\1/p' | tr -d '"'
}

# New local KEK: the current one becomes kek.previous (still read for data keys it wraps), the control plane
# re-wraps every data key under the new one. kek.previous stays: backups taken before the rotation need it.
kek_rotate() {
  [ "$(kek_provider)" = local ] || die "FALAK_KEK_PROVIDER is $(kek_provider): rotate the key in KMS / Vault (or point FALAK_KEK_* at a new key), then: falak-ctl artisan falak:keys:rotate-kek --all"
  ensure_kek --quiet
  is_running control-plane || die "the control plane is not running (falak-ctl up first)"
  # kek.previous is about to be retired: only when no data key still needs it (an unfinished rotation).
  local report stale
  report="$(keys_check_json)" || die "falak:keys:check failed; fix that before rotating (falak-ctl artisan falak:keys:check)"
  stale="$(json_number stale "$report")"
  [ -n "$stale" ] || die "could not read falak:keys:check --json: $report"
  [ "$stale" = 0 ] || die "$stale data key(s) are still wrapped by an earlier KEK ($KEK_PREVIOUS): finish that rotation first (falak-ctl artisan falak:keys:rotate-kek), then rotate again"
  if [ -f "$KEK_PREVIOUS" ]; then
    local old; old="$SECRETS_DIR/kek.retired-$(kek_fingerprint "$KEK_PREVIOUS")"
    mv "$KEK_PREVIOUS" "$old"
    warn "the KEK before the last rotation moved to $old (backups older than that rotation need it)"
  fi
  local before; before="$(kek_fingerprint "$KEK_FILE")"
  mv "$KEK_FILE" "$KEK_PREVIOUS"
  kek_write_new "$KEK_FILE"
  info "rotating the KEK: $before -> $(kek_fingerprint "$KEK_FILE")"
  # shellcheck disable=SC2086  # service names, space-separated
  compose restart $PHP_SERVICES >/dev/null
  wait_healthy 420 >/dev/null || die "the stack did not become healthy with the new KEK (the old one is $KEK_PREVIOUS)"
  compose exec -T control-plane php artisan falak:keys:rotate-kek --no-interaction \
    || die "re-wrapping the data keys failed; both KEKs are in place, run: falak-ctl artisan falak:keys:rotate-kek"
  ok "every data key is wrapped by the new KEK; the previous one stays at $KEK_PREVIOUS for older backups"
  say "  Export a new emergency kit now: falak-ctl kek export <file>"
}

curl_config_quote() { # curl_config_quote VALUE -> "VALUE" for a curl config file (\ and " escaped)
  local v="$1"
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  printf '"%s"' "$v"
}

registry_code() { # registry_code [--auth] -> HTTP status of GET /v2/ through the edge
  local host
  host="$(env_get FALAK_REGISTRY_HOST)"
  [ -n "$host" ] || { echo none; return 0; }
  if [ "${1:-}" = --auth ]; then
    # Credentials via a curl config on stdin, never on the command line.
    printf 'user = %s\n' "$(curl_config_quote "$(env_get FALAK_REGISTRY_USERNAME):$(env_get FALAK_REGISTRY_PASSWORD)")" \
      | edge_curl "$host" /v2/ -o /dev/null -w '%{http_code}' -K - 2>/dev/null || true
    return 0
  fi
  edge_curl "$host" /v2/ -o /dev/null -w '%{http_code}' 2>/dev/null || true
}

cmd_registry() {
  require_install
  local sub="${1:-status}"; shift || true
  case "$sub" in
    status)
      ensure_registry_env
      say "  address: https://$(env_get FALAK_REGISTRY_URL)  (user $(env_get FALAK_REGISTRY_USERNAME); password: FALAK_REGISTRY_PASSWORD in $ENV_FILE)"
      if is_running registry; then
        ok "registry running, $(compose exec -T registry du -sh /var/lib/registry 2>/dev/null | cut -f1 || echo '?') stored"
      else bad "registry is not running (falak-ctl up)"; fi
      local code; code="$(registry_code --auth)"
      if [ "$code" = 200 ]; then ok "https://$(env_get FALAK_REGISTRY_HOST)/v2/ answers with the credentials (200)"
      else bad "https://$(env_get FALAK_REGISTRY_HOST)/v2/ with the credentials -> ${code:-no response}"; fi
      ;;
    gc)
      # Removes layers and untagged manifests nothing references. The registry is stopped meanwhile: a push
      # during garbage collection could lose layers, so it is skipped while an image build is queued or running
      # (the control plane's falak:registry-idle exits 1; the weekly cron run tries again next week). --force skips
      # the check.
      local dry="" force="" status=0 arg idle
      for arg in "$@"; do
        case "$arg" in
          --dry-run) dry="--dry-run" ;;
          --force) force=1 ;;
          *) die "usage: falak-ctl registry gc [--dry-run] [--force]" ;;
        esac
      done
      is_running registry || die "registry is not running"
      if [ -z "$force" ]; then
        if ! idle="$(compose exec -T control-plane php artisan falak:registry-idle 2>&1)"; then
          warn "$(date '+%Y-%m-%d %H:%M') skipping registry garbage collection: ${idle##*$'\n'}" \
            "(tried again next week; falak-ctl registry gc --force runs it anyway)"
          return 0
        fi
      fi
      info "garbage-collecting the built-in registry${dry:+ (dry run)}"
      # A subshell whose EXIT trap, installed before the stop, starts the registry again however it ends (failure,
      # Ctrl-C, kill). set -e does not apply inside `( ) || …`, hence the explicit exits.
      (
        trap 'trap - EXIT; compose start registry >/dev/null || { bad "the registry did not start again (falak-ctl up)"; exit 1; }' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        compose stop registry >/dev/null || exit 1
        # shellcheck disable=SC2086  # optional flag
        if compose run --rm --no-deps -T registry garbage-collect --delete-untagged $dry /etc/docker/registry/config.yml \
          | grep -Ev ': marking (blob|manifest) ' | tail -3; then
          ok "garbage collection done"
        else warn "garbage collection failed (falak-ctl logs registry)"; exit 1; fi
      ) || status=$?
      return "$status"
      ;;
    prune)
      # Deletes images no build or release needs (the control plane also runs this daily); gc frees the space.
      local args=()
      [ "${1:-}" = --dry-run ] && args=(--dry-run)
      compose exec -T control-plane php artisan falak:registry-prune "${args[@]}"
      ;;
    *) die "usage: falak-ctl registry status | prune [--dry-run] | gc [--dry-run] [--force]" ;;
  esac
}

# --- health -----------------------------------------------------------------------------------------
health_check() { # quiet health check used by update/restore; prints problems
  local failed=0 svc state health
  while read -r svc state health; do
    [ -n "$svc" ] || continue
    if [ "$state" != "running" ]; then bad "$svc is $state"; failed=1
    elif [ -n "$health" ] && [ "$health" != "healthy" ]; then bad "$svc is $health"; failed=1
    fi
  done < <(compose ps -a --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null)
  local code
  code="$(edge_curl "$(env_get FALAK_DOMAIN)" /up -o /dev/null -w '%{http_code}' 2>/dev/null || true)"
  if [ "$code" = "200" ]; then ok "panel $(env_get FALAK_URL)/up -> 200"; else bad "panel $(env_get FALAK_URL)/up -> ${code:-no response}"; failed=1; fi
  return "$failed"
}

# --- PHP threads (FrankenPHP admin API inside the container) -------------------------------------------
# The panel (control-plane) and the agent API (agent-api) each have their own PHP thread pool. A request that
# finds every thread busy waits in a queue, so a saturated pool shows up as slow pages / late heartbeats.
PHP_POOLS="control-plane agent-api"

pool_label() { case "$1" in control-plane) echo panel ;; *) echo "$1" ;; esac; }

pool_knob() { case "$1" in agent-api) echo FALAK_AGENT_API_THREADS ;; *) echo FALAK_PHP_MAX_THREADS ;; esac; }

php_threads() { # php_threads SERVICE -> "BUSY CAPACITY" (capacity = started + reserved for autoscaling)
  # shellcheck disable=SC2016  # PHP code
  compose exec -T "$1" php -r '
    $j = json_decode((string) @file_get_contents("http://localhost:2019/frankenphp/threads"), true);
    if (! is_array($j)) { exit(1); }
    $t = $j["ThreadDebugStates"] ?? [];
    echo count(array_filter($t, fn ($x) => (bool) ($x["IsBusy"] ?? false))), " ", count($t) + (int) ($j["ReservedThreadCount"] ?? 0), "\n";
  ' 2>/dev/null
}

legacy_thread_config() { # the 0.2.x hotfix line in custom.env, if present
  grep -E '^[[:space:]]*FRANKENPHP_CONFIG=.*(num|max)_threads' "$FALAK_DIR/custom.env" 2>/dev/null | tail -1 || true
}

wait_healthy() { # wait_healthy [timeout]
  local timeout="${1:-300}"
  compose up -d --wait --wait-timeout "$timeout" --remove-orphans
  recreate_drifted "$timeout"
}

# --- bind-mounted config files --------------------------------------------------------------------------
# compose.yml bind-mounts config files and directories from deploy/ and observability/ (loki.yaml, tempo.yaml,
# the gateway Caddyfile, Grafana provisioning). An update swaps those directories, and a running container keeps
# the files it was started with: the mount pins the old inode. `compose up` does not recreate a service whose
# compose definition is unchanged, so without this Loki kept running the previous loki.yaml. Compare what each
# running container sees (docker cp reads through its mounts) with the files on disk and force-recreate exactly
# the services that differ. This also repairs containers left stale by older falak-ctl versions.
mount_matches() { # mount_matches CONTAINER HOST_PATH CONTAINER_PATH -> 0 when the container sees the host content
  local pid tmp rc=1
  # Linux: read through the container's own mount namespace. `docker cp` re-resolves bind mounts from the host
  # path there, so it would show the new file even while the container still sees the replaced inode.
  pid="$(docker inspect -f '{{.State.Pid}}' "$1" 2>/dev/null || echo 0)"
  if [ "${pid:-0}" -gt 0 ] && [ -r "/proc/$pid/root/" ]; then
    diff -r "/proc/$pid/root$3" "$2" >/dev/null 2>&1
    return
  fi
  # Docker Desktop (no host /proc for the VM's processes): `docker cp` reads the container's view.
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/.falak-mount.XXXXXX")"
  if docker cp "$1:$3" - 2>/dev/null | tar -xf - -C "$tmp" 2>/dev/null \
    && diff -r "$tmp/$(basename "$3")" "$2" >/dev/null 2>&1; then
    rc=0
  fi
  rm -rf "$tmp"
  return "$rc"
}

bundle_path() { # bundle_path HOST_PATH -> 0 when it lies in the install's deploy/ or observability/
  local root
  root="$(cd "$FALAK_DIR" 2>/dev/null && pwd -P || echo "$FALAK_DIR")"
  case "$1" in
    "$FALAK_DIR"/deploy/*|"$FALAK_DIR"/observability/*|"$root"/deploy/*|"$root"/observability/*) return 0 ;;
  esac
  return 1
}

mount_drift() { # prints each running service whose mounted Falak config differs from the files on disk
  local svc id src dst
  while read -r svc id; do
    [ -n "$id" ] || continue
    while IFS='|' read -r src dst; do
      if [ -z "$src" ] || ! bundle_path "$src"; then continue; fi
      if ! mount_matches "$id" "$src" "$dst"; then echo "$svc"; break; fi
    done < <(docker inspect -f '{{range .Mounts}}{{if eq .Type "bind"}}{{.Source}}|{{.Destination}}{{"\n"}}{{end}}{{end}}' "$id" 2>/dev/null || true)
  done < <(compose ps --format '{{.Service}} {{.ID}}' 2>/dev/null || true)
}

recreate_drifted() { # recreate_drifted [timeout] : force-recreate services whose mounted config files changed
  local drifted
  drifted="$(mount_drift | sort -u | tr '\n' ' ')"
  drifted="${drifted% }"
  [ -n "$drifted" ] || return 0
  info "mounted config files changed: recreating $drifted"
  # shellcheck disable=SC2086  # service names, space-separated
  compose up -d --wait --wait-timeout "${1:-300}" --no-deps --force-recreate $drifted
  ok "recreated $drifted"
}

# --- deploy bundle (compose.yml, edge/control-plane files, observability configs) ---------------------
# Source: FALAK_DEPLOY_SOURCE (local checkout dir), or the GitHub release asset falak-deploy.tar.gz.
fetch_bundle() { # fetch_bundle VERSION DEST_DIR
  local version="$1" dest="$2" src repo tmp
  src="$(env_get FALAK_DEPLOY_SOURCE)"
  rm -rf "$dest"; mkdir -p "$dest"
  if [ -n "$src" ]; then
    [ -d "$src/deploy" ] || die "FALAK_DEPLOY_SOURCE=$src has no deploy/ directory"
    cp -R "$src/deploy" "$dest/deploy"
    cp -R "$src/observability" "$dest/observability"
    return 0
  fi
  repo="$(env_get FALAK_REPO "$FALAK_REPO_DEFAULT")"
  tmp="$(tmpdir)"
  curl -fsSL --retry 3 -o "$tmp/falak-deploy.tar.gz" "https://github.com/$repo/releases/download/$version/falak-deploy.tar.gz" \
    || { rm -rf "$tmp"; die "could not download falak-deploy.tar.gz for $version from github.com/$repo"; }
  # Fail closed: a bundle is never installed unverified (FALAK_DEPLOY_SOURCE copies above are the operator's own).
  curl -fsSL --retry 3 -o "$tmp/SHA256SUMS" "https://github.com/$repo/releases/download/$version/SHA256SUMS" \
    || { rm -rf "$tmp"; die "could not download SHA256SUMS for $version from github.com/$repo: refusing to install an unverified bundle"; }
  local want got
  want="$(awk '$2 == "falak-deploy.tar.gz" { print $1 }' "$tmp/SHA256SUMS")"
  [[ "$want" =~ ^[0-9a-f]{64}$ ]] \
    || { rm -rf "$tmp"; die "SHA256SUMS of $version has no single falak-deploy.tar.gz line: refusing to install an unverified bundle"; }
  got="$(sha256sum "$tmp/falak-deploy.tar.gz" | cut -d' ' -f1)"
  [ "$got" = "$want" ] || { rm -rf "$tmp"; die "checksum mismatch for falak-deploy.tar.gz"; }
  tar -xzf "$tmp/falak-deploy.tar.gz" -C "$dest"
  rm -rf "$tmp"
}

latest_version() {
  local repo
  repo="$(env_get FALAK_REPO "$FALAK_REPO_DEFAULT")"
  curl -fsSL "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null \
    | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1
}

install_bundle() { # install_bundle STAGED_DIR : swap deploy/ + observability/ into place, keep *.prev
  local staged="$1" d
  for d in deploy observability; do
    rm -rf "$FALAK_DIR/$d.prev"
    [ -d "$FALAK_DIR/$d" ] && mv "$FALAK_DIR/$d" "$FALAK_DIR/$d.prev"
    mv "$staged/$d" "$FALAK_DIR/$d"
  done
  if [ -f "$FALAK_DIR/deploy/falak-ctl" ] && [ -w /usr/local/bin ] && [ "$(id -u)" = 0 ]; then
    install -m 0755 "$FALAK_DIR/deploy/falak-ctl" /usr/local/bin/falak-ctl
  fi
}

restore_prev_bundle() {
  local d
  for d in deploy observability; do
    if [ -d "$FALAK_DIR/$d.prev" ]; then rm -rf "${FALAK_DIR:?}/$d"; mv "$FALAK_DIR/$d.prev" "$FALAK_DIR/$d"; fi
  done
}

# pull_attempts VALUE : VALUE when it is a positive integer, else 4 (with a warning).
pull_attempts() {
  case "$1" in
    '' | *[!0-9]*) ;;
    *) if [ "$((10#$1))" -ge 1 ]; then echo "$((10#$1))"; return 0; fi ;;
  esac
  warn "FALAK_PULL_ATTEMPTS='$1' is not a positive number; using 4"
  echo 4
}

# pull_permanent FILE : the pull's error output is a registry refusal no retry fixes: no access, or no such image or
# tag. Registry phrases only — a network error that merely says "not found" (a DNS lookup) stays transient. Kept
# identical in deploy/install.sh and deploy/falak-ctl (deploy/tests/pull-retry.sh checks it).
pull_permanent() {
  grep -qiE 'manifest unknown|manifest (for )?[^ ]+ not found|pull access denied|requested access to the resource is denied|unauthorized:|authentication required|": denied(:|$)' "$1"
}

# pull_retry CMD... : run an image pull, retrying transient registry errors ("connection reset by peer", IPv6
# resets, 5xx) with backoff: FALAK_PULL_ATTEMPTS tries (default 4), waiting 5s, 10s, 20s ... in between. Errors no
# retry can fix (access denied, unknown manifest or tag) fail at once.
pull_retry() {
  local attempt=1 max delay err
  max="$(pull_attempts "$(env_get FALAK_PULL_ATTEMPTS "${FALAK_PULL_ATTEMPTS:-4}")")"; delay="${FALAK_PULL_DELAY:-5}"
  err="$(mktemp "${TMPDIR:-/tmp}/.falak-pull.XXXXXX")"
  until "$@" 2>"$err"; do
    cat "$err" >&2
    if pull_permanent "$err"; then
      rm -f "$err"
      bad "image pull failed: the registry refused it (access denied, or no such image or tag); not retrying"
      return 1
    fi
    if [ "$attempt" -ge "$max" ]; then
      rm -f "$err"
      bad "image pull failed $attempt times, giving up"
      return 1
    fi
    warn "image pull failed (attempt $attempt of $max, usually a transient registry or network error); retrying in ${delay}s"
    sleep "$delay"
    attempt=$((attempt + 1)); delay=$((delay * 2))
  done
  cat "$err" >&2
  rm -f "$err"
}

pull_images() { # pull_images [missing] : all images (update), or only the ones not present yet (up)
  if [ "$(env_get FALAK_PULL 1)" = "0" ]; then
    info "FALAK_PULL=0: using local images"
    return 0
  fi
  if [ "${1:-}" = missing ]; then
    pull_retry compose pull --quiet --policy missing
  else
    pull_retry compose pull --quiet
  fi
}

# The images this install pulls or builds itself (never third-party images such as postgres or grafana).
falak_image_repos() {
  local prefix
  prefix="$(env_get FALAK_IMAGE_PREFIX)"
  [ -n "$prefix" ] || return 0
  printf '%s\n' "$prefix/falak-control-plane" "$prefix/falak-edge" "$prefix/falak-builder"
}

# prune_images [--dry-run]: remove Falak images other than FALAK_VERSION and FALAK_PREVIOUS_VERSION (the rollback
# target). Images still used by a container are left alone (no --force); volumes are never touched.
prune_images() {
  local dry=0 current previous repo tag id ref removed=0 kept=0
  [ "${1:-}" = "--dry-run" ] && dry=1
  current="$(env_get FALAK_VERSION)"
  previous="$(env_get FALAK_PREVIOUS_VERSION)"
  [ -n "$current" ] || { warn "FALAK_VERSION is not set; not pruning images"; return 0; }
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    while read -r tag id; do
      [ -n "$id" ] || continue
      if [ "$tag" = "$current" ] || { [ -n "$previous" ] && [ "$tag" = "$previous" ]; }; then
        kept=$((kept + 1)); continue
      fi
      if [ "$tag" = "<none>" ]; then ref="$id"; else ref="$repo:$tag"; fi
      if [ "$dry" = 1 ]; then
        say "  would remove $ref"; removed=$((removed + 1))
      elif docker image rm "$ref" >/dev/null 2>&1; then
        say "  removed $ref"; removed=$((removed + 1))
      else
        warn "kept $ref (in use or referenced elsewhere)"
      fi
    done < <(docker image ls --format '{{.Tag}} {{.ID}}' "$repo" 2>/dev/null || true)
  done < <(falak_image_repos)
  if [ "$dry" = 1 ]; then ok "$removed old Falak image(s) would be removed, $kept kept"
  else ok "$removed old Falak image(s) removed, $kept kept (${current}${previous:+, $previous})"; fi
}

# after_update_images PREV TARGET: keep exactly one rollback target, then prune. FALAK_PRUNE_IMAGES=0 keeps every image;
# FALAK_PULL=0 runs locally built images that cannot be pulled again, so they are never removed automatically.
after_update_images() {
  [ "$1" = "$2" ] || env_set FALAK_PREVIOUS_VERSION "$1"
  if [ "$(env_get FALAK_PULL 1)" = "0" ]; then
    say "  FALAK_PULL=0: keeping old images (falak-ctl prune-images removes them)"
  elif [ "$(env_get FALAK_PRUNE_IMAGES 1)" != "0" ]; then
    prune_images || warn "could not prune old images"
  fi
}

cmd_prune_images() {
  require_install
  case "${1:-}" in
    ""|--dry-run)
      [ "$(env_get FALAK_PULL 1)" != "0" ] || warn "FALAK_PULL=0: removed images were built locally and cannot be pulled again"
      prune_images "$@" ;;
    *) die "usage: falak-ctl prune-images [--dry-run]" ;;
  esac
}

# --- commands -----------------------------------------------------------------------------------------
cmd_status() {
  require_install
  info "Falak $(env_get FALAK_VERSION) at $FALAK_DIR (project $FALAK_PROJECT)"
  compose ps --format 'table {{.Service}}\t{{.Status}}\t{{.Image}}'
  say
  say "  panel:      $(env_get FALAK_URL)"
  say "  agent API:  $(env_get FALAK_AGENT_API_URL)"
  if [ -n "$(env_get FALAK_GRAFANA_HOST)" ]; then say "  grafana:    $(env_get FALAK_GRAFANA_PUBLIC_URL)"; fi
  local svc usage threads=""
  for svc in $PHP_POOLS; do
    usage="$(php_threads "$svc" || true)"
    [ -n "$usage" ] || continue
    threads="${threads:+$threads · }$(pool_label "$svc") ${usage% *}/${usage#* } busy"
  done
  say "  PHP threads: ${threads:-unavailable}"
  local last
  last="$(latest_backup)"
  say "  last backup: ${last:-none}"
}

cmd_logs() {
  require_install
  local follow=() svc=()
  for a in "$@"; do
    case "$a" in -f|--follow) follow=(-f) ;; *) svc+=("$a") ;; esac
  done
  compose logs --tail="${FALAK_LOG_TAIL:-200}" "${follow[@]}" "${svc[@]}"
}

latest_backup() { # newest by name (UTC timestamps sort)
  [ -d "$BACKUP_DIR" ] || return 0
  find "$BACKUP_DIR" -maxdepth 1 -type f -name 'falak-backup-*' ! -name '*.sha256' 2>/dev/null | sort -r | head -1 || true
}

# --- DR settings (dr/dr.env) ----------------------------------------------------------------------------
# FALAK_BACKUP_PASSPHRASE, FALAK_BACKUP_S3_{ENDPOINT,BUCKET,REGION,ACCESS_KEY,SECRET_KEY,PREFIX}, FALAK_DR_EVERY_HOURS,
# FALAK_DR_DRILL (monthly | off), FALAK_BACKUP_REGISTRY (1 = include registry-data). Only restore and dr setup
# (DR_ENV_FALLBACK=1) read a setting missing from the file from the environment (a fresh host: install.sh
# --restore-from, falak-ctl restore s3://… before dr setup); scheduled backups and drills use the file alone.
DR_ENV_FALLBACK=0
dr_get() { # dr_get KEY [default]
  local v=""
  if [ -f "$DR_FILE" ]; then v="$(grep -E "^$1=" "$DR_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"; fi
  if [ -z "$v" ] && [ "$DR_ENV_FALLBACK" = 1 ]; then v="$(printenv "$1" 2>/dev/null || true)"; fi
  printf '%s' "${v:-${2:-}}"
}

dr_set() { # dr_set KEY VALUE  (atomic; dr/ 0700, dr.env 0600)
  local tmp
  install -d -m 0700 "$DR_DIR"
  chmod 0700 "$DR_DIR"
  tmp="$(mktemp "$DR_DIR/.dr.env.XXXXXX")"
  chmod 600 "$tmp"
  if [ -f "$DR_FILE" ]; then grep -vE "^$1=" "$DR_FILE" > "$tmp" || true; fi
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$DR_FILE"
}

# --- authenticated backup encryption (format FALAK-DR-BACKUP 3, *.fdr) -----------------------------------------
# encrypt-then-MAC with standard tools only: AES-256-CBC (openssl enc, PBKDF2-SHA256, 600 000 iterations, random salt)
# and HMAC-SHA256 over the header and the whole ciphertext. The MAC key is HMAC(PBKDF2(passphrase, mac_salt),
# "falak-dr-mac-v3"): its own salt (never the ciphertext's) and a label, so it is never a key openssl encrypts with.
# Opening copies the file into a private directory first and reads only that copy (a file swapped after the MAC check
# can't be decrypted instead), parses the header strictly by position, checks the MAC before anything is decrypted or
# extracted and returns the authenticated name and creation time. The passphrase only reaches openssl through its
# environment; the derived keys never leave this shell (bash builtins build the HMAC pads).
#
#   line 1  FALAK-DR-BACKUP 3
#   line 2  name: falak-backup-20261010T060000Z-scheduled
#   line 3  created_at: 20261010T060000Z
#   line 4  kdf: pbkdf2-sha256-600000
#   line 5  mac_salt: <16 hex>   (8 bytes, openssl enc -S; must differ from the ciphertext's salt)
#   line 6  mac: <64 hex>        HMAC-SHA256(mac key, lines 1-5 || ciphertext)
#   line 7  (empty)
#   then    the ciphertext: openssl enc output, "Salted__" + 8-byte salt + AES-256-CBC blocks
DR_FORMAT="FALAK-DR-BACKUP 3"
DR_KDF_ITER=600000
DR_HEADER_LINES=7
DR_MAC_LABEL="falak-dr-mac-v3"

hex_of() { od -An -tx1 | tr -d ' \n'; }

# dr_kdf SALT_HEX : 32-byte key (hex) from the passphrase in FALAK_DR_PASS (environment) and the salt.
dr_kdf() {
  openssl enc -aes-256-cbc -pbkdf2 -iter "$DR_KDF_ITER" -md sha256 -S "$1" -pass env:FALAK_DR_PASS -P 2>/dev/null \
    | sed -n 's/^key=//p' | tr 'A-F' 'a-f'
}

# hmac_sha256 KEY_HEX < data -> hex digest (RFC 2104; the key's pads are built with printf, a builtin).
hmac_sha256() {
  local key="$1" ipad="" opad="" i b x inner
  for ((i = 0; i < 64; i++)); do
    b=0
    if [ $((i * 2)) -lt ${#key} ]; then b=$((16#${key:i*2:2})); fi
    printf -v x '\\x%02x' $((b ^ 0x36)); ipad+="$x"
    printf -v x '\\x%02x' $((b ^ 0x5c)); opad+="$x"
  done
  # shellcheck disable=SC2059  # the pads are format strings of \x escapes on purpose
  inner="$({ printf "$ipad"; cat; } | openssl dgst -sha256 -binary | hex_of)"
  # shellcheck disable=SC2059
  { printf "$opad"; printf "$(printf '%s' "$inner" | sed 's/../\\x&/g')"; } | openssl dgst -sha256 -binary | hex_of
}

# dr_mac_key SALT_HEX -> the MAC key (hex): the PBKDF2 output, separated from any encryption use by a label.
dr_mac_key() {
  local kdf
  kdf="$(dr_kdf "$1")"
  [ "${#kdf}" = 64 ] || return 1
  printf '%s' "$DR_MAC_LABEL" | hmac_sha256 "$kdf"
}

# ct_salt FILE OFFSET -> the 8-byte salt (hex) openssl enc wrote after "Salted__", or nothing.
ct_salt() {
  [ "$(tail -c +"$(($2 + 1))" "$1" | head -c 8)" = "Salted__" ] || return 0
  tail -c +"$(($2 + 9))" "$1" | head -c 8 | hex_of
}

# dr_seal PLAIN OUT NAME CREATED : encrypt and authenticate a backup archive (passphrase in FALAK_DR_PASS).
dr_seal() {
  local plain="$1" out="$2" name="$3" created="$4" salt key header mac ct
  ct="$out.ct"
  TMP_LIST="$TMP_LIST $ct"
  openssl enc -aes-256-cbc -pbkdf2 -iter "$DR_KDF_ITER" -md sha256 -salt -pass env:FALAK_DR_PASS -in "$plain" -out "$ct" || { rm -f "$ct"; return 1; }
  salt="$(rand_hex 8)"
  while [ "$salt" = "$(ct_salt "$ct" 0)" ]; do salt="$(rand_hex 8)"; done
  key="$(dr_mac_key "$salt")" || { rm -f "$ct"; return 1; }
  [ "${#key}" = 64 ] || { rm -f "$ct"; return 1; }
  header="$(printf '%s\nname: %s\ncreated_at: %s\nkdf: pbkdf2-sha256-%s\nmac_salt: %s\n' "$DR_FORMAT" "$name" "$created" "$DR_KDF_ITER" "$salt")"$'\n'
  mac="$({ printf '%s' "$header"; cat "$ct"; } | hmac_sha256 "$key")"
  { printf '%s' "$header"; printf 'mac: %s\n\n' "$mac"; cat "$ct"; } > "$out" || { rm -f "$ct"; return 1; }
  rm -f "$ct"
}

# dr_header FILE FIELD -> a header field read by its position (name 2, created_at 3, kdf 4, mac_salt 5, mac 6), or
# nothing when that line is not exactly "FIELD: value". Informational (dr status, tests); dr_open parses on its own.
dr_header() {
  local n
  case "$2" in name) n=2 ;; created_at) n=3 ;; kdf) n=4 ;; mac_salt) n=5 ;; mac) n=6 ;; *) return 0 ;; esac
  head -n "$n" "$1" 2>/dev/null | tail -n 1 | sed -n "s/^$2: //p"
}

is_sealed() { [ "$(head -n 1 "$1" 2>/dev/null)" = "$DR_FORMAT" ]; }

# dr_open FILE PLAIN_OUT [EXPECTED_NAME] : copy, parse, verify the MAC (and the bound name), then decrypt the copy.
# Sets DR_OPEN_NAME / DR_OPEN_CREATED from the authenticated header. Dies on any mismatch.
dr_open() {
  local file="$1" out="$2" expect="${3:-}" label priv copy hlen line1 name created kdf salt want key have size
  label="$(basename "$file")"
  priv="$(tmpdir)"; chmod 700 "$priv"
  copy="$priv/backup.fdr"
  cp -- "$file" "$copy" || die "$label could not be read"
  chmod 600 "$copy"
  # Exactly seven newline-terminated header lines, each where it belongs.
  local header=()
  mapfile -t header < <(head -n "$DR_HEADER_LINES" "$copy" | LC_ALL=C tr -d '\r' | head -n "$DR_HEADER_LINES")
  hlen="$(head -n "$DR_HEADER_LINES" "$copy" | wc -c | tr -d ' ')"
  line1="${header[0]:-}"
  [ "$line1" = "$DR_FORMAT" ] || die "$label is not an authenticated Falak backup ($DR_FORMAT)"
  if [ "${#header[@]}" != "$DR_HEADER_LINES" ] || [ "$(head -c "$hlen" "$copy" | tail -c 1 | hex_of)" != 0a ]; then
    die "$label: truncated header"
  fi
  [[ "${header[1]}" =~ ^name:\ (falak-backup-[A-Za-z0-9._-]+)$ ]] || die "$label: damaged header (name)"; name="${BASH_REMATCH[1]}"
  [[ "${header[2]}" =~ ^created_at:\ ([0-9]{8}T[0-9]{6}Z)$ ]] || die "$label: damaged header (created_at)"; created="${BASH_REMATCH[1]}"
  kdf="${header[3]}"
  [ "$kdf" = "kdf: pbkdf2-sha256-$DR_KDF_ITER" ] || die "$label: unknown key derivation"
  [[ "${header[4]}" =~ ^mac_salt:\ ([0-9a-f]{16})$ ]] || die "$label: damaged header (mac_salt)"; salt="${BASH_REMATCH[1]}"
  [[ "${header[5]}" =~ ^mac:\ ([0-9a-f]{64})$ ]] || die "$label: damaged header (mac)"; want="${BASH_REMATCH[1]}"
  [ -z "${header[6]}" ] || die "$label: damaged header (no empty line before the ciphertext)"
  # The ciphertext: "Salted__", its own salt (never the MAC's), whole AES blocks.
  size=$(( $(wc -c < "$copy" | tr -d ' ') - hlen ))
  if [ "$size" -lt 32 ] || [ $(( (size - 16) % 16 )) != 0 ]; then die "$label: truncated or damaged ciphertext"; fi
  [ "$(ct_salt "$copy" "$hlen")" != "" ] || die "$label: damaged ciphertext"
  [ "$(ct_salt "$copy" "$hlen")" != "$salt" ] || die "$label: the MAC salt is the ciphertext's salt"
  key="$(dr_mac_key "$salt")" || die "could not derive the backup key (openssl with PBKDF2 needed)"
  [ "${#key}" = 64 ] || die "could not derive the backup key (openssl with PBKDF2 needed)"
  have="$({ head -n 5 "$copy"; tail -c +"$((hlen + 1))" "$copy"; } | hmac_sha256 "$key")"
  [ "$have" = "$want" ] || die "$label failed authentication: wrong DR passphrase, or the file was changed"
  if [ -n "$expect" ] && [ "$name" != "$expect" ]; then
    die "$label is backup '$name', not '$expect' (renamed or replayed object)"
  fi
  tail -c +"$((hlen + 1))" "$copy" | openssl enc -d -aes-256-cbc -pbkdf2 -iter "$DR_KDF_ITER" -md sha256 -pass env:FALAK_DR_PASS -out "$out" 2>/dev/null \
    || die "$label could not be decrypted"
  rm -rf "$priv"
  DR_OPEN_NAME="$name"; DR_OPEN_CREATED="$created"
}

# --- one stateful command at a time ------------------------------------------------------------------------------
# backup, restore, update and drill take $FALAK_DIR/.ctl.lock (flock). Timers wait for it (WAIT seconds); commands run
# by hand fail at once with a clear message. Nested calls (update's backup and rollback) hold it already.
CTL_LOCKED=0
ctl_lock() { # ctl_lock [WAIT]
  [ "$CTL_LOCKED" = 0 ] || return 0
  command -v flock >/dev/null 2>&1 || return 0
  exec 9>>"$FALAK_DIR/.ctl.lock"
  if [ "${1:-0}" -gt 0 ]; then
    flock -w "$1" 9 || die "another falak-ctl backup, restore, update or drill still runs after ${1}s; this run is skipped"
  else
    flock -n 9 || die "another falak-ctl backup, restore, update or drill is running; try again once it finished"
  fi
  CTL_LOCKED=1
}

s3_configured() { [ -n "$(dr_get FALAK_BACKUP_S3_ENDPOINT)" ] && [ -n "$(dr_get FALAK_BACKUP_S3_BUCKET)" ]; }

dr_configured() { # uploads to a bucket, encrypted, on a schedule
  s3_configured && [ -n "$(dr_get FALAK_BACKUP_PASSPHRASE)" ] && [ -f "$(systemd_dir)/falak-backup.timer" ]
}

dr_every_hours() { dr_get FALAK_DR_EVERY_HOURS 6; }

# --- state/dr.json: what the panel's Settings → Disaster recovery shows --------------------------------
# dr.state holds KEY=VALUE lines (no secrets) that backup, drill and setup update; dr.json is rebuilt from it.
state_get() { grep -E "^$1=" "$DR_STATE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }

state_set() { # state_set KEY=VALUE... (one line each; newlines become spaces)
  install -d -m 0755 "$STATE_DIR"
  local tmp kv key keys=""
  for kv in "$@"; do keys="$keys|${kv%%=*}"; done
  tmp="$(mktemp "$STATE_DIR/.dr.state.XXXXXX")"
  if [ -f "$DR_STATE" ]; then grep -vE "^(${keys#|})=" "$DR_STATE" > "$tmp" || true; fi
  for kv in "$@"; do
    key="${kv%%=*}"
    printf '%s=%s\n' "$key" "$(printf '%s' "${kv#*=}" | tr '\n\r' '  ' | cut -c1-500)" >> "$tmp"
  done
  chmod 644 "$tmp"
  mv "$tmp" "$DR_STATE"
  dr_write_json
}

json_str() { # json_str VALUE -> "VALUE" (JSON string; empty -> null)
  local v="$1"
  [ -n "$v" ] || { printf 'null'; return 0; }
  v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; v="$(printf '%s' "$v" | tr -d '\000-\037')"
  printf '"%s"' "$v"
}

json_int() { case "$1" in '' | *[!0-9]*) printf 'null' ;; *) printf '%s' "$1" ;; esac; }

json_bool() { case "$1" in 1) printf 'true' ;; 0) printf 'false' ;; *) printf 'null' ;; esac; }

dr_write_json() {
  install -d -m 0755 "$STATE_DIR"
  local configured=0 encrypted=0 target="" tmp
  if dr_configured; then configured=1; fi
  if [ -n "$(dr_get FALAK_BACKUP_PASSPHRASE)" ]; then encrypted=1; fi
  if s3_configured; then target="s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$(dr_get FALAK_BACKUP_S3_PREFIX falak)"; fi
  tmp="$(mktemp "$STATE_DIR/.dr.json.XXXXXX")"
  {
    printf '{"version":1,"updated_at":%s,"falak_version":%s,' "$(json_str "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" "$(json_str "$(env_get FALAK_VERSION)")"
    printf '"configured":%s,"encrypted":%s,"target":%s,"endpoint":%s,' "$(json_bool "$configured")" "$(json_bool "$encrypted")" \
      "$(json_str "$target")" "$(json_str "$(dr_get FALAK_BACKUP_S3_ENDPOINT | sed -E 's#^(https?://)([^/@]*@)?([^/]+).*#\1\3#')")"
    printf '"schedule_hours":%s,"drill_schedule":%s,"include_registry":%s,' "$(json_int "$(dr_every_hours)")" \
      "$(json_str "$(dr_get FALAK_DR_DRILL off)")" "$(json_bool "$(dr_get FALAK_BACKUP_REGISTRY 0)")"
    printf '"last_backup":{"name":%s,"at":%s,"size_bytes":%s,"uploaded":%s,"encrypted":%s,"kek_id":%s},' \
      "$(json_str "$(state_get backup_name)")" "$(json_str "$(state_get backup_at)")" "$(json_int "$(state_get backup_size)")" \
      "$(json_bool "$(state_get backup_uploaded)")" "$(json_bool "$(state_get backup_encrypted)")" "$(json_str "$(state_get backup_kek_id)")"
    printf '"last_failure":{"at":%s,"error":%s},' "$(json_str "$(state_get failure_at)")" "$(json_str "$(state_get failure_error)")"
    printf '"last_drill":{"at":%s,"ok":%s,"backup":%s,"duration_s":%s,"message":%s}}\n' \
      "$(json_str "$(state_get drill_at)")" "$(json_bool "$(state_get drill_ok)")" "$(json_str "$(state_get drill_backup)")" \
      "$(json_int "$(state_get drill_duration)")" "$(json_str "$(state_get drill_message)")"
  } > "$tmp"
  chmod 644 "$tmp"
  mv "$tmp" "$DR_JSON"
}

# --- S3 (path-style, SigV4 via curl; the keys reach curl in a config on stdin, never on its command line) -----
s3_curl() { # s3_curl [curl args...] : signed request with the DR bucket's credentials
  local region
  region="$(dr_get FALAK_BACKUP_S3_REGION us-east-1)"
  printf 'user = %s\n' "$(curl_config_quote "$(dr_get FALAK_BACKUP_S3_ACCESS_KEY):$(dr_get FALAK_BACKUP_S3_SECRET_KEY)")" \
    | curl -fsS --retry 3 --aws-sigv4 "aws:amz:$region:s3" -K - "$@"
}

s3_prefix() { local p; p="$(dr_get FALAK_BACKUP_S3_PREFIX falak)"; printf '%s' "${p:+${p%/}/}"; }

s3_url() { # s3_url KEY -> https://endpoint/bucket/KEY
  printf '%s/%s/%s' "$(dr_get FALAK_BACKUP_S3_ENDPOINT | sed 's#/*$##')" "$(dr_get FALAK_BACKUP_S3_BUCKET)" "$1"
}

urlencode() { # urlencode VALUE (RFC 3986 unreserved kept)
  local s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in [a-zA-Z0-9.~_-]) out="$out$c" ;; *) out="$out$(printf '%%%02X' "'$c")" ;; esac
  done
  printf '%s' "$out"
}

s3_put() { # s3_put FILE KEY
  s3_curl -H "x-amz-content-sha256: UNSIGNED-PAYLOAD" -T "$1" "$(s3_url "$2")" -o /dev/null
}

s3_get() { # s3_get KEY OUT
  s3_curl -H "x-amz-content-sha256: UNSIGNED-PAYLOAD" -o "$2" "$(s3_url "$1")"
}

s3_list() { # s3_list PREFIX -> object keys, one per line (ListObjectsV2, every page)
  local token="" page query
  while :; do
    query="list-type=2&prefix=$(urlencode "$1")"
    if [ -n "$token" ]; then query="$query&continuation-token=$(urlencode "$token")"; fi
    page="$(s3_curl -H "x-amz-content-sha256: UNSIGNED-PAYLOAD" "$(s3_url "")?$query")" || return 1
    printf '%s' "$page" | tr '<' '\n' | sed -n 's/^Key>//p'
    token="$(printf '%s' "$page" | tr '<' '\n' | sed -n 's/^NextContinuationToken>//p' | head -1)"
    [ -n "$token" ] || return 0
  done
}

# s3_backup_key REF -> the object key of s3://REF: "latest" is the newest falak-backup-*.fdr (names sort by time),
# otherwise REF is a backup name (with or without .fdr) under the prefix. Only authenticated backups (.fdr) are
# considered: anything else in the bucket (a plaintext .tar.gz, the old unauthenticated .tar.gz.enc) is ignored.
s3_backup_key() {
  local ref="$1" prefix keys
  prefix="$(s3_prefix)"
  keys="$(s3_list "${prefix}falak-backup-")" || die "listing s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$prefix failed (endpoint, bucket and keys right?)"
  keys="$(printf '%s\n' "$keys" | grep -E '(^|/)falak-backup-[A-Za-z0-9._-]*\.fdr$' | sort || true)"
  if [ "$ref" = latest ]; then
    [ -n "$keys" ] || die "no backups in s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$prefix"
    printf '%s\n' "$keys" | tail -1
    return 0
  fi
  case "$ref" in */* | *..*) die "s3://$ref: give a backup name (falak-backup-…) or latest" ;; esac
  case "$ref" in *.fdr | *[!A-Za-z0-9._-]*) ;; *.tar.gz | *.enc) die "s3://$ref: only authenticated backups (.fdr) are restored from the bucket" ;; esac
  local want
  for want in "$prefix$ref" "$prefix$ref.fdr"; do
    if printf '%s\n' "$keys" | grep -qxF "$want"; then printf '%s\n' "$want"; return 0; fi
  done
  die "no backup named $ref in s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$prefix (falak-ctl dr status lists the latest)"
}

# s3_fetch REF DIR -> path of the downloaded backup (authenticated later, before anything is extracted: dr_open).
s3_fetch() {
  local ref="$1" dir="$2" key out
  s3_configured || die "no DR bucket: run falak-ctl dr setup, or set FALAK_BACKUP_S3_ENDPOINT, _BUCKET, _ACCESS_KEY and _SECRET_KEY"
  key="$(s3_backup_key "$ref")"
  out="$dir/$(basename "$key")"
  info "downloading s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$key" >&2
  s3_get "$key" "$out.part" || { rm -f "$out.part"; die "downloading $key failed"; }
  mv "$out.part" "$out"
  chmod 600 "$out"
  printf '%s\n' "$out"
}

s3_upload() { # s3_upload FILE REQUIRED : to the DR bucket; only authenticated, encrypted backups (.fdr) leave the host
  local file="$1" required="$2" key
  if ! s3_configured; then
    [ "$required" = 1 ] && die "--upload: no DR bucket configured (falak-ctl dr setup)"
    return 0
  fi
  case "$file" in
    *.fdr) ;;
    *) if [ "$required" = 1 ]; then die "refusing to upload an unencrypted backup: set the DR passphrase (falak-ctl dr setup)"; fi
       warn "not uploaded: backups only leave this host encrypted (set the DR passphrase: falak-ctl dr setup)"
       return 0 ;;
  esac
  key="$(s3_prefix)$(basename "$file")"
  if s3_put "$file" "$key"; then
    ok "uploaded to s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$key"
    UPLOADED=1
    return 0
  fi
  [ "$required" = 1 ] && die "upload to s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$key failed (the local backup is kept)"
  warn "S3 upload to s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$key failed (the local backup is kept)"
}

# --- backup -----------------------------------------------------------------------------------------------
BACKUP_VOLUMES="falak-ca app-storage caddy-data edge-pki"

# Row counts of the tables a restore must bring back (drills compare them). "table:count,…".
ROW_COUNT_TABLES="users organizations servers sites databases_instances kernel_data_keys"
row_counts() {
  local list
  # shellcheck disable=SC2086  # table names, space-separated
  list="$(printf "'%s'," $ROW_COUNT_TABLES)"
  compose exec -T postgres psql -U falak -d falak -tA -c \
    "select string_agg(t || ':' || (xpath('/row/c/text()', query_to_xml(format('select count(*) as c from %I', t), false, true, '')))[1]::text, ',' order by t) from unnest(array[${list%,}]) t where to_regclass(t) is not null;" \
    2>/dev/null | tr -d ' \r\n'
}

image_digests() { # one "service=repo@sha256:…" line per image the install runs
  local svc image digest
  compose config --format json 2>/dev/null | tr ',' '\n' | sed -n 's/^.*"image": *"\([^"]*\)".*$/\1/p' | sort -u | while read -r image; do
    digest="$(docker image inspect --format '{{index .RepoDigests 0}}' "$image" 2>/dev/null || true)"
    svc="${image##*/}"; svc="${svc%%:*}"
    printf 'image.%s=%s\n' "$svc" "${digest:-$image}"
  done
}

cmd_backup() {
  require_install
  local label="" quiet=0 upload=0 registry
  registry="$(dr_get FALAK_BACKUP_REGISTRY 0)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --label) label="-$2"; shift ;;
      --label=*) label="-${1#--label=}" ;;
      --quiet) quiet=1 ;;
      --upload) upload=1 ;;
      --include-registry) registry=1 ;;
      --scheduled) ;;
      *) die "backup: unknown option $1" ;;
    esac
    shift
  done
  local pass
  pass="$(dr_get FALAK_BACKUP_PASSPHRASE)"
  # Checked before anything is written: an upload is always encrypted.
  if [ "$upload" = 1 ]; then
    [ -n "$pass" ] || die "--upload needs the DR passphrase: backups only leave this host encrypted (falak-ctl dr setup)"
    s3_configured || die "--upload: no DR bucket configured (falak-ctl dr setup)"
  fi
  label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9._\n-' '-')"
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
  local ts name work out
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  name="falak-backup-$ts$label"
  work="$(tmpdir "$BACKUP_DIR")"
  [ "$quiet" = 1 ] || info "backup $name"

  is_running postgres || compose up -d --wait postgres >/dev/null
  compose exec -T postgres pg_dump -U falak -d falak -Fc --no-owner > "$work/db.dump" \
    || die "pg_dump failed"
  [ -s "$work/db.dump" ] || die "pg_dump produced an empty dump"
  [ "$quiet" = 1 ] || ok "database ($(du -h "$work/db.dump" | cut -f1))"

  local vol vols="$BACKUP_VOLUMES"
  [ "$registry" = 1 ] && vols="$vols registry-data"
  for vol in $vols; do
    docker run --rm -v "$(volume "$vol"):/data:ro" "$(util_image)" tar -C /data -czf - . > "$work/$vol.tar.gz" \
      || die "could not archive volume $vol"
  done
  # The Fleet CA key is in the database (encrypted with APP_KEY); ca.pem + agent-api cert are in falak-ca.
  tar -tzf "$work/falak-ca.tar.gz" 2>/dev/null | grep -q 'ca.pem' || warn "Fleet CA certificate not found in the falak-ca volume (no agents enrolled yet?)"
  [ "$quiet" = 1 ] || ok "volumes: ${vols// /, }"

  # The KEK decrypts every secret in db.dump. It (and the KMS / Vault credentials that reach it) goes into the
  # backup only when the backup itself is encrypted with the DR passphrase: a plain archive with both would hand
  # out every secret. Without it, the KEK must be kept separately.
  local stripped=0
  copy_env_for_backup "$ENV_FILE" "$work/env" "$pass" || stripped=1
  if [ -f "$FALAK_DIR/custom.env" ]; then copy_env_for_backup "$FALAK_DIR/custom.env" "$work/custom.env" "$pass" || stripped=1; fi
  if [ "$stripped" = 1 ]; then
    warn "THE KEK PROVIDER'S CREDENTIALS (FALAK_KEK_AWS_* / FALAK_KEK_VAULT_TOKEN) WERE LEFT OUT OF THIS UNENCRYPTED BACKUP."
    warn "Keep them separately, or set a DR passphrase (falak-ctl dr setup) to encrypt backups and include them."
  fi
  local kek_id=""
  if [ "$(kek_provider)" = local ] && [ -f "$KEK_FILE" ]; then
    kek_id="$(kek_fingerprint "$KEK_FILE")"
    if [ -n "$pass" ]; then
      mkdir -m 700 "$work/secrets"
      cp "$KEK_FILE" "$work/secrets/kek"
      [ -f "$KEK_PREVIOUS" ] && cp "$KEK_PREVIOUS" "$work/secrets/kek.previous"
      [ "$quiet" = 1 ] || ok "key-encryption key $kek_id (in the encrypted backup)"
    else
      warn "THIS BACKUP DOES NOT CONTAIN THE KEY-ENCRYPTION KEY ($KEK_FILE, id $kek_id)."
      warn "Without it the secrets in this backup can't be decrypted. Keep the KEK separately (falak-ctl kek export <file>),"
      warn "or set a DR passphrase (falak-ctl dr setup) to encrypt backups and include it."
    fi
  fi
  {
    echo "falak_version=$(env_get FALAK_VERSION)"
    echo "backup_name=$name"
    echo "created_at=$ts"
    echo "host=$(hostname)"
    echo "domain=$(env_get FALAK_DOMAIN)"
    echo "encrypted=$([ -n "$pass" ] && echo 1 || echo 0)"
    echo "volumes=$vols"
    echo "kek_provider=$(kek_provider)"
    if [ -n "$kek_id" ]; then echo "kek_id=$kek_id"; fi
    # The KEKs the database's data keys are wrapped by (restore checks this host has them).
    if is_running control-plane; then echo "kek_ids=$(json_kek_ids "$(keys_check_json || true)")"; fi
    echo "rows=$(row_counts || true)"
    echo "docker_version=$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
    image_digests || true
  } > "$work/manifest"

  out="$BACKUP_DIR/$name.tar.gz"
  # The plaintext archive must not outlive a failed or interrupted encryption (cleanup on exit removes both).
  TMP_LIST="$TMP_LIST $out.tmp $BACKUP_DIR/$name.fdr.tmp"
  tar -C "$work" -czf "$out.tmp" . || die "could not write $out.tmp"
  if [ -n "$pass" ]; then
    if ! FALAK_DR_PASS="$pass" dr_seal "$out.tmp" "$BACKUP_DIR/$name.fdr.tmp" "$name" "$ts"; then
      rm -f "$out.tmp" "$BACKUP_DIR/$name.fdr.tmp"
      die "encrypting the backup failed; nothing was kept"
    fi
    rm -f "$out.tmp"
    mv "$BACKUP_DIR/$name.fdr.tmp" "$BACKUP_DIR/$name.fdr"
    out="$BACKUP_DIR/$name.fdr"
  else
    mv "$out.tmp" "$out"
  fi
  chmod 600 "$out"
  [ "$quiet" = 1 ] || ok "wrote $out ($(du -h "$out" | cut -f1)) — contains secrets (.env with APP_KEY, the sealed database), keep it safe"

  UPLOADED=0
  s3_upload "$out" "$upload"

  # retention (local)
  local keep
  keep="$(env_get FALAK_BACKUP_KEEP 14)"
  find "$BACKUP_DIR" -maxdepth 1 -type f -name 'falak-backup-*' ! -name '*.sha256' | sort -r | tail -n +"$((keep + 1))" | while read -r old; do
    rm -f "$old"; [ "$quiet" = 1 ] || say "  pruned $(basename "$old")"
  done
  state_set "backup_name=$(basename "$out")" "backup_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" "backup_size=$(file_size "$out")" \
    "backup_uploaded=$UPLOADED" "backup_encrypted=$([ -n "$pass" ] && echo 1 || echo 0)" "backup_kek_id=$kek_id"
  LAST_BACKUP="$out"
}

# The scheduled backup (falak-backup.service): a failure is recorded for the panel's alerts before it exits.
cmd_backup_scheduled() {
  local err rc=0
  err="$(mktemp "${TMPDIR:-/tmp}/.falak-backup-err.XXXXXX")"
  ( trap cleanup EXIT; cmd_backup "$@" ) 2> "$err" || rc=$?
  cat "$err" >&2
  if [ "$rc" != 0 ]; then
    state_set "failure_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      "failure_error=$(sed 's/\x1b\[[0-9;]*m//g' "$err" | grep -E 'error:|✗' | tail -1 | sed 's/^ *//')"
  fi
  rm -f "$err"
  return "$rc"
}

# copy_env_for_backup SRC DEST PASSPHRASE : an env file for the backup. Unencrypted backups leave out the KEK
# provider's credentials (they reach the KEK). Returns 1 when it left something out.
copy_env_for_backup() {
  local pattern='^[[:space:]]*(export[[:space:]]+)?FALAK_KEK_(AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY|AWS_SESSION_TOKEN|VAULT_TOKEN)='
  if [ -n "$3" ] || ! grep -Eq "$pattern" "$1"; then
    cp "$1" "$2"
    return 0
  fi
  grep -Ev "$pattern" "$1" > "$2" || true
  return 1
}

# extract_backup FILE DIR [EXPECTED_NAME] : an authenticated backup (.fdr) is verified with the DR passphrase before tar
# sees a byte, and its manifest must name the same backup. From the bucket only .fdr is accepted (s3_backup_key);
# the older unauthenticated formats (.tar.gz.enc, plain .tar.gz) are restored from local files only, with a warning.
extract_backup() {
  local file="$1" dir="$2" expect="${3:-}" pass plain name created
  pass="$(dr_get FALAK_BACKUP_PASSPHRASE)"
  case "$file" in
    *.fdr)
      [ -n "$pass" ] || die "$(basename "$file") is encrypted: the DR passphrase is needed (FALAK_BACKUP_PASSPHRASE in the environment, or falak-ctl dr setup)"
      plain="$(mktemp "$dir/.plain.XXXXXX")"
      FALAK_DR_PASS="$pass" dr_open "$file" "$plain" "$expect"
      # From the authenticated header dr_open parsed (never the file again: it may have changed since).
      name="$DR_OPEN_NAME"; created="$DR_OPEN_CREATED"
      tar -xzf "$plain" -C "$dir" || { rm -f "$plain"; die "$(basename "$file") could not be unpacked"; }
      rm -f "$plain"
      [ "$(sed -n 's/^encrypted=//p' "$dir/manifest" 2>/dev/null)" = 1 ] || die "$(basename "$file"): its manifest does not say encrypted"
      [ "$(sed -n 's/^backup_name=//p' "$dir/manifest")" = "$name" ] || die "$(basename "$file"): the manifest names another backup"
      [ "$(sed -n 's/^created_at=//p' "$dir/manifest")" = "$created" ] || die "$(basename "$file"): the manifest has another creation time"
      ;;
    *.enc)
      [ -z "$expect" ] || die "$(basename "$file"): unauthenticated backups are not restored from the bucket"
      warn "$(basename "$file") uses the old unauthenticated format (no MAC): only restore it if it never left this host"
      [ -n "$pass" ] || die "$file is encrypted: the DR passphrase is needed (FALAK_BACKUP_PASSPHRASE in the environment, or falak-ctl dr setup)"
      FALAK_BACKUP_PASSPHRASE="$pass" openssl enc -d -aes-256-cbc -pbkdf2 -pass env:FALAK_BACKUP_PASSPHRASE -in "$file" 2>/dev/null \
        | tar -xzf - -C "$dir" 2>/dev/null || die "$file could not be decrypted (wrong DR passphrase?) or is damaged" ;;
    *)
      [ -z "$expect" ] || die "$(basename "$file"): unencrypted backups are not restored from the bucket"
      warn "$(basename "$file") is not encrypted: only restore it if it never left this host"
      tar -xzf "$file" -C "$dir" ;;
  esac
  if [ ! -s "$dir/db.dump" ] || [ ! -f "$dir/env" ]; then die "$file is not a Falak backup (db.dump/env missing)"; fi
}

# The settings a backup may never bring back: which images run, from where, and compose's own knobs. A backup's
# .env otherwise wins (APP_KEY, passwords, domains); these stay this host's.
RESTORE_PINNED="FALAK_VERSION FALAK_IMAGE_PREFIX FALAK_REPO FALAK_DEPLOY_SOURCE FALAK_PULL FALAK_EDGE_SUBNET FALAK_EDGE_IP COMPOSE_PROFILES"

# restore_env FILE : install a backup's env file as .env, keeping this host's pinned settings; COMPOSE_* / DOCKER_*
# lines from the backup are dropped (compose would read them).
restore_env() {
  local src="$1" k saved=() tmp kv
  for k in $RESTORE_PINNED; do
    if grep -qE "^$k=" "$ENV_FILE" 2>/dev/null; then saved+=("$k=$(env_get "$k")"); fi
  done
  tmp="$(mktemp "$FALAK_DIR/.env.XXXXXX")"
  chmod 600 "$tmp"
  grep -vE '^[[:space:]]*(export[[:space:]]+)?(COMPOSE_|DOCKER_)' "$src" > "$tmp" || true
  for k in $RESTORE_PINNED; do
    grep -vE "^[[:space:]]*(export[[:space:]]+)?$k=" "$tmp" > "$tmp.f" || true
    mv "$tmp.f" "$tmp"
  done
  mv "$tmp" "$ENV_FILE"
  for kv in "${saved[@]}"; do env_set "${kv%%=*}" "${kv#*=}"; done
}

# version_newer A B -> 0 when release A (vX.Y.Z) is newer than B; anything else (main, a sha) is not compared.
version_newer() {
  case "$1:$2" in v[0-9]*.[0-9]*.[0-9]*:v[0-9]*.[0-9]*.[0-9]*) ;; *) return 1 ;; esac
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "${1#v}" "${2#v}" | sort -V | tail -1)" = "${1#v}" ]
}

# restore_source ARG -> a local backup file: a path, a name in backups/, or s3://latest | s3://NAME (downloaded
# into backups/, verified).
restore_source() {
  local file="$1"
  case "$file" in
    s3://*)
      [ -n "${file#s3://}" ] || die "usage: falak-ctl restore s3://latest | s3://<backup name>"
      mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
      s3_fetch "${file#s3://}" "$BACKUP_DIR"
      return 0 ;;
  esac
  if [ ! -f "$file" ] && [ -f "$BACKUP_DIR/$file" ]; then file="$BACKUP_DIR/$file"; fi
  [ -f "$file" ] || die "no such file: $file"
  printf '%s\n' "$file"
}

cmd_restore() {
  require_install
  DR_ENV_FALLBACK=1
  local file="" yes=0 keep_env=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1 ;;
      --keep-env) keep_env=1 ;;
      --force) force=1 ;;
      -*) die "restore: unknown option $1" ;;
      *) file="$1" ;;
    esac
    shift
  done
  [ -n "$file" ] || die "usage: falak-ctl restore <backup file | s3://latest | s3://NAME> [--yes] [--keep-env] [--force]"
  if [ "$yes" != 1 ]; then
    [ -t 0 ] || die "restore replaces the database, storage and Fleet CA: re-run with --yes to confirm"
    printf 'Restore %s? This REPLACES the database, app storage, Fleet CA, edge PKI and .env. [y/N] ' "$file"
    read -r answer; [ "$answer" = y ] || [ "$answer" = Y ] || die "aborted"
  fi
  local expect=""
  case "$file" in s3://*) expect=1 ;; esac
  file="$(restore_source "$file")"
  # From the bucket, the object's name is bound into the authenticated header (a renamed or replayed object fails).
  if [ -n "$expect" ]; then expect="$(basename "$file" .fdr)"; fi
  RESTORE_EXPECT="$expect" do_restore "$file" "$keep_env" "$force"
}

# restore_kek_check WORK_DIR FORCE : before anything is replaced, a backup without its KEK may only be restored
# when this host has every KEK its data keys are wrapped by (secrets/kek or kek.previous), unless --force.
restore_kek_check() {
  local work="$1" force="$2" ids have="" id missing="" provider
  # The backup's provider (a fresh host's .env says local until the restored one replaces it).
  provider="$(sed -n 's/^kek_provider=//p' "$work/manifest" 2>/dev/null | tail -1)"
  [ "${provider:-$(kek_provider)}" = local ] || return 0
  [ ! -f "$work/secrets/kek" ] || return 0
  ids="$(sed -n 's/^kek_ids=//p' "$work/manifest" 2>/dev/null || true)"
  [ -n "$ids" ] || ids="$(sed -n 's/^kek_id=//p' "$work/manifest" 2>/dev/null || true)"
  [ -n "$ids" ] || return 0   # older than v0.10.0: nothing sealed under a KEK yet
  if [ -f "$KEK_FILE" ]; then have="$(kek_fingerprint "$KEK_FILE")"; fi
  if [ -f "$KEK_PREVIOUS" ]; then have="$have $(kek_fingerprint "$KEK_PREVIOUS")"; fi
  for id in ${ids//,/ }; do
    case " $have " in *" $id "*) ;; *) missing="$missing $id" ;; esac
  done
  [ -n "$missing" ] || return 0
  if [ "$force" = 1 ]; then
    warn "restoring without KEK(s)$missing: the control plane won't start until they are back (falak-ctl kek import <kit> --force)"
    return 0
  fi
  die "the backup's data keys are wrapped by KEK(s)$missing, which this host doesn't have (secrets/kek, kek.previous:${have:- none}). Import it first (falak-ctl kek import <emergency kit> --force), or restore anyway with --force"
}

restore_kek() { # restore_kek WORK_DIR : the backup's KEK replaces this host's (it sealed the restored database)
  local work="$1" id
  [ "$(kek_provider)" = local ] || return 0
  install -d -m 0711 "$SECRETS_DIR"
  if [ -f "$work/secrets/kek" ]; then
    id="$(kek_fingerprint "$work/secrets/kek")"
    if [ -f "$KEK_FILE" ] && [ "$(kek_fingerprint "$KEK_FILE")" != "$id" ]; then
      mv "$KEK_FILE" "$KEK_FILE.replaced-$(date -u +%Y%m%dT%H%M%SZ)"
      warn "this host's KEK was replaced by the backup's (kept as $KEK_FILE.replaced-*)"
    fi
    install -m 0400 "$work/secrets/kek" "$KEK_FILE"
    if [ -f "$work/secrets/kek.previous" ] && [ ! -f "$KEK_PREVIOUS" ]; then install -m 0400 "$work/secrets/kek.previous" "$KEK_PREVIOUS"; fi
    ensure_kek --quiet
    ok "key-encryption key $id restored"
    return 0
  fi
  # No KEK in the backup: restore_kek_check made sure this host has the ones it needs (or --force).
  ensure_kek --quiet
}

restore_database() { # restore_database WORK_DIR : recreate the falak database from db.dump (postgres running)
  # Align the role password with the (restored) .env; local socket connections are trusted in the image.
  compose exec -T postgres psql -v ON_ERROR_STOP=1 -U falak -d postgres -q \
    -c "ALTER USER falak PASSWORD '$(env_get DB_PASSWORD)';" \
    -c "DROP DATABASE IF EXISTS falak WITH (FORCE);" -c "CREATE DATABASE falak OWNER falak;" >/dev/null \
    || die "could not recreate the database"
  compose exec -T postgres pg_restore -U falak -d falak --no-owner --exit-on-error < "$1/db.dump" \
    || die "pg_restore failed"
}

restore_volumes() { # restore_volumes WORK_DIR VOLUME... : those the backup has; prints the ones restored
  local work="$1" vol list=""
  shift
  for vol in "$@"; do
    [ -f "$work/$vol.tar.gz" ] || continue
    docker volume create "$(volume "$vol")" >/dev/null
    docker run --rm -i -v "$(volume "$vol"):/data" "$(util_image)" \
      sh -c 'find /data -mindepth 1 -delete && tar -C /data -xzf -' < "$work/$vol.tar.gz" \
      || die "could not restore volume $vol"
    list="${list:+$list, }$vol"
  done
  printf '%s' "$list"
}

# restore_age_note WORK_DIR : say how old the backup is; warn when it is older than twice the backup schedule (someone
# may have deleted the newer ones: a rollback).
restore_age_note() {
  local c at age
  c="$(sed -n 's/^created_at=//p' "$1/manifest" 2>/dev/null | tail -1)"
  [[ "$c" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || { warn "the backup records no creation time"; return 0; }
  at="${c:0:4}-${c:4:2}-${c:6:2}T${c:9:2}:${c:11:2}:${c:13:2}Z"
  age=$(( $(date -u +%s) - $(iso_epoch "$at") ))
  [ "$age" -ge 0 ] || age=0
  say "  backup taken $at ($(human_age "$age") ago)"
  if [ "$age" -gt $(( $(dr_every_hours) * 2 * 3600 )) ]; then
    warn "this backup is older than twice the $(dr_every_hours) h schedule: everything since $at is lost. If a newer one should exist, check the bucket (deleted objects?) before going on"
  fi
}

do_restore() { # do_restore FILE KEEP_ENV [FORCE]
  local file="$1" keep_env="$2" force="${3:-0}" work
  work="$(tmpdir)"
  info "restoring $(basename "$file")"
  extract_backup "$file" "$work" "${RESTORE_EXPECT:-}"
  sed 's/^/  /' "$work/manifest" 2>/dev/null | grep -v '^  image\.' || true
  local made_by
  made_by="$(sed -n 's/^falak_version=//p' "$work/manifest" 2>/dev/null | tail -1)"
  if version_newer "$made_by" "$(env_get FALAK_VERSION)"; then
    if [ "$force" = 1 ]; then warn "the backup was made by Falak $made_by, newer than this host's $(env_get FALAK_VERSION) (--force)"
    else die "the backup was made by Falak $made_by, newer than this host's $(env_get FALAK_VERSION): install $made_by (or newer) first (install.sh --version $made_by), or restore anyway with --force"; fi
  fi
  restore_age_note "$work"
  restore_kek_check "$work" "$force"

  # shellcheck disable=SC2086
  compose stop $APP_SERVICES edge >/dev/null 2>&1 || true
  if [ "$keep_env" != 1 ]; then
    # Which images run and how compose runs them stay this host's (RESTORE_PINNED).
    restore_env "$work/env"
    if [ -f "$work/custom.env" ]; then install -m 600 "$work/custom.env" "$FALAK_DIR/custom.env"; fi
    ok ".env restored (this host's version, image source and compose settings kept)"
  fi

  restore_kek "$work"

  compose up -d --wait postgres valkey >/dev/null
  restore_database "$work"
  ok "database restored"
  local restored
  # shellcheck disable=SC2086  # volume names, space-separated
  restored="$(restore_volumes "$work" $BACKUP_VOLUMES registry-data)"
  ok "volumes restored: $restored"

  # valkey picks up a changed password on recreate; web runs migrations (a newer image migrates the old dump).
  wait_healthy 420 || { bad "stack did not become healthy after restore"; return 1; }
  health_check || return 1
  ok "restore complete"
}

# --- disaster recovery: dr setup | status | drill -------------------------------------------------------------
systemd_dir() { printf '%s' "${FALAK_SYSTEMD_DIR:-/etc/systemd/system}"; }
ctl_path() { command -v falak-ctl 2>/dev/null || echo /usr/local/bin/falak-ctl; }

iso_epoch() { # iso_epoch 2026-10-10T06:00:00Z -> seconds (0 when empty or unparsable)
  local s=""
  if [ -n "$1" ]; then s="$(date -u -d "$1" +%s 2>/dev/null || date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null || true)"; fi
  printf '%s' "${s:-0}"
}

human_age() { # human_age SECONDS
  local s="$1"
  if [ "$s" -lt 3600 ]; then printf '%d min' $((s / 60))
  elif [ "$s" -lt 172800 ]; then printf '%d h' $((s / 3600))
  else printf '%d days' $((s / 86400)); fi
}

dr_calendar() { # dr_calendar HOURS -> systemd OnCalendar
  if [ "$1" = 24 ]; then printf '*-*-* 03:00:00'; else printf '*-*-* 00/%s:00:00' "$1"; fi
}

valid_every() { case "$1" in 1|2|3|4|6|8|12|24) return 0 ;; *) return 1 ;; esac; }

write_unit() { # write_unit FILE CONTENT -> 0 when it changed
  if [ -f "$1" ] && [ "$(cat "$1")" = "$2" ]; then return 1; fi
  printf '%s\n' "$2" > "$1"
  chmod 644 "$1"
}

# Backups every FALAK_DR_EVERY_HOURS (falak-backup.timer) and, with FALAK_DR_DRILL=monthly, a drill on the first of
# each month (falak-drill.timer). Both run falak-ctl as root, outside the containers.
dr_install_timers() {
  local dir ctl every drill changed=0 env_line
  dir="$(systemd_dir)"; ctl="$(ctl_path)"; every="$(dr_every_hours)"; drill="$(dr_get FALAK_DR_DRILL off)"
  valid_every "$every" || die "FALAK_DR_EVERY_HOURS=$every: use 1, 2, 3, 4, 6, 8, 12 or 24"
  mkdir -p "$dir"
  env_line="Environment=FALAK_DIR=$FALAK_DIR FALAK_PROJECT=$FALAK_PROJECT"
  write_unit "$dir/falak-backup.service" "[Unit]
Description=Falak control plane backup to the DR bucket (falak-ctl backup --upload)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
$env_line
ExecStart=$ctl backup --upload --scheduled --quiet --label scheduled
Nice=10
IOSchedulingClass=idle" && changed=1
  write_unit "$dir/falak-backup.timer" "[Unit]
Description=Falak control plane backup every $every h

[Timer]
OnCalendar=$(dr_calendar "$every")
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target" && changed=1
  if [ "$drill" = monthly ]; then
    write_unit "$dir/falak-drill.service" "[Unit]
Description=Falak control plane restore drill (falak-ctl dr drill)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
$env_line
ExecStart=$ctl dr drill --scheduled
TimeoutStartSec=2h
Nice=10" && changed=1
    write_unit "$dir/falak-drill.timer" "[Unit]
Description=Falak control plane restore drill, monthly

[Timer]
OnCalendar=*-*-01 04:30:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target" && changed=1
  elif [ -f "$dir/falak-drill.timer" ]; then
    if command -v systemctl >/dev/null 2>&1; then systemctl disable --now falak-drill.timer >/dev/null 2>&1 || true; fi
    rm -f "$dir/falak-drill.timer" "$dir/falak-drill.service"
    changed=1
  fi
  if command -v systemctl >/dev/null 2>&1; then
    if [ "$changed" = 1 ]; then systemctl daemon-reload || warn "systemctl daemon-reload failed"; fi
    systemctl enable --now falak-backup.timer >/dev/null 2>&1 || warn "could not enable falak-backup.timer (systemctl status falak-backup.timer)"
    if [ "$drill" = monthly ]; then
      systemctl enable --now falak-drill.timer >/dev/null 2>&1 || warn "could not enable falak-drill.timer"
    fi
  else
    warn "no systemctl here: enable $dir/falak-backup.timer yourself"
  fi
  ok "backups every $every h (falak-backup.timer)$([ "$drill" = monthly ] && echo ', restore drill monthly (falak-drill.timer)')"
}

# --- host channel: the panel asks, root on the host acts (docs/INSTALL.md, "Updating from the panel") -------------
# state/host (root:www-data 1770, mounted read-write into control-plane, horizon and scheduler only at /falak/host): the
# panel writes request.json atomically; falak-host.path starts falak-host.service (`falak-ctl host-run`), which takes
# the file away and runs only what its allowlist describes:
#   {"id":"<26 letters/digits>","action":"update","version":"vX.Y.Z"}            -> falak-ctl update --version vX.Y.Z
#   {"id":"…","action":"local-server","install_url":"$FALAK_URL/install/<token>"} -> falak-ctl local-server enable
# status.json ({"id","action","state":"running|succeeded|failed","started_at","finished_at","exit_code","log"}) and
# <id>.log (last 20 kept) are written by root, 0644. The sticky bit keeps the panel from removing or renaming them;
# every file root creates there is a fresh mktemp name renamed into place (never opened by a guessable path).
HOST_DIR="$STATE_DIR/host"
HOST_LOCK="$STATE_DIR/.host.lock"
LOCAL_EDGE_ENV="${FALAK_LOCAL_EDGE_ENV:-/etc/falak/local-edge.env}"
HOST_KEEP_LOGS=20

ensure_host_dir() {
  install -d -m 0755 "$STATE_DIR"
  mkdir -p "$HOST_DIR"
  chown "0:$(app_uid)" "$HOST_DIR" 2>/dev/null || [ "$(id -u)" != 0 ] || warn "could not chown $HOST_DIR to root:$(app_uid)"
  chmod 1770 "$HOST_DIR"
}

host_new_file() { # host_new_file NAME : prints a fresh 0644 temp file in HOST_DIR; `mv -f` it to NAME when written
  local tmp
  tmp="$(mktemp "$HOST_DIR/.$1.XXXXXX")"
  chmod 644 "$tmp"
  printf '%s' "$tmp"
}

host_prune_logs() { # host_prune_logs REGEX : keep the newest HOST_KEEP_LOGS logs whose name matches
  local old me
  me="$(id -u)"
  # Only names this script writes (no newline or slash can sneak into the list), only regular files it owns (root):
  # whatever the panel puts there is never counted or removed.
  # shellcheck disable=SC2010,SC2012  # ls -t: names are checked against REGEX
  old="$(ls -1t "$HOST_DIR" 2>/dev/null | grep -E "^$1\$" | while read -r f; do
    if [ -f "$HOST_DIR/$f" ] && [ ! -L "$HOST_DIR/$f" ] && [ "$(file_uid "$HOST_DIR/$f")" = "$me" ]; then printf '%s\n' "$f"; fi
  done | tail -n +$((HOST_KEEP_LOGS + 1)) || true)"
  [ -z "$old" ] || printf '%s\n' "$old" | while read -r f; do rm -f "${HOST_DIR:?}/$f"; done
}

# The last update host-run started finished at this epoch (root-only state/, so a rejected request can't reset it).
HOST_LAST_UPDATE="$STATE_DIR/.host-last-update"
HOST_UPDATE_GAP=600
host_update_too_soon() { # 0 when an update requested from the panel finished less than HOST_UPDATE_GAP seconds ago
  local last
  last="$(cat "$HOST_LAST_UPDATE" 2>/dev/null || true)"
  case "$last" in '' | *[!0-9]*) return 1 ;; esac
  [ $(($(date +%s) - last)) -lt "$HOST_UPDATE_GAP" ]
}
local_server_allowed() { [ "$(env_get FALAK_HOST_ALLOW_LOCAL_SERVER 0)" = 1 ]; }

host_status() { # host_status ID ACTION STATE STARTED FINISHED EXIT [ERROR]
  local tmp log=""
  [ -z "$1" ] || log="$1.log"
  tmp="$(host_new_file status.json)"
  printf '{"id":%s,"action":%s,"state":%s,"started_at":%s,"finished_at":%s,"exit_code":%s,"log":%s,"error":%s}\n' \
    "$(json_str "$1")" "$(json_str "$2")" "$(json_str "$3")" "$(json_str "$4")" "$(json_str "$5")" "$(json_int "$6")" \
    "$(json_str "$log")" "$(json_str "${7:-}")" > "$tmp"
  mv -f "$tmp" "$HOST_DIR/status.json"
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# json_field KEY JSON -> the string value of "KEY" when it occurs exactly once and holds no escapes but \/ (PHP's
# json_encode writes https:\/\/…). Every value is then checked against a strict pattern, so no general parser is needed.
json_field() {
  local m
  m="$(printf '%s' "$2" | grep -oE "\"$1\"[[:space:]]*:[[:space:]]*\"([^\"\\\\]|\\\\/)*\"" || true)"
  [ -n "$m" ] && [ "$(printf '%s\n' "$m" | wc -l | tr -d ' ')" = 1 ] || return 1
  printf '%s' "$m" | sed -E 's/^"[^"]*"[[:space:]]*:[[:space:]]*"//; s/"$//; s#\\/#/#g'
}

valid_request_id() { [[ "$1" =~ ^[0-9A-Za-z]{26}$ ]]; }
valid_version() { [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
valid_install_url() { # FALAK_URL/install/<token>, token [A-Za-z0-9_-]+
  local base
  base="$(env_get FALAK_URL)"; base="${base%/}"
  [ -n "$base" ] || return 1
  case "$1" in "$base/install/"?*) ;; *) return 1 ;; esac
  [[ "${1#"$base/install/"}" =~ ^[A-Za-z0-9_-]+$ ]]
}

# host_take : moves request.json out of the panel's reach, validates it and starts the job. 1 when rejected.
host_take() {
  local req raw id="" action version="" url="" arg
  req="$(mktemp "$STATE_DIR/.host-request.XXXXXX")"
  # rename moves a symlink itself, never its target; a directory (or anything mv can't move) is removed.
  if ! mv -f "$HOST_DIR/request.json" "$req" 2>/dev/null; then
    rm -rf "${HOST_DIR:?}/request.json"; rm -f "$req"
    warn "host request: request.json could not be taken; removed"; return 1
  fi
  if [ -L "$req" ] || [ ! -f "$req" ]; then rm -rf "$req"; host_status "" "" failed "" "$(now_iso)" "" "request.json is not a regular file"; return 1; fi
  raw="$(head -c 4096 "$req")"; rm -f "$req"
  id="$(json_field id "$raw" || true)"
  if ! valid_request_id "$id"; then host_status "" "" failed "" "$(now_iso)" "" "invalid request id"; warn "host request: invalid id"; return 1; fi
  action="$(json_field action "$raw" || true)"
  case "$action" in
    update)
      version="$(json_field version "$raw" || true)"
      valid_version "$version" || { host_status "$id" update failed "" "$(now_iso)" "" "invalid version (vX.Y.Z)"; warn "host request $id: invalid version"; return 1; }
      # Forward only: a downgrade (or a reinstall of the same version) is for root on the host.
      version_newer "$version" "$(env_get FALAK_VERSION)" \
        || { host_status "$id" update failed "" "$(now_iso)" "" "$version is not newer than $(env_get FALAK_VERSION)"; warn "host request $id: $version is not newer"; return 1; }
      if host_update_too_soon; then
        host_status "$id" update failed "" "$(now_iso)" "" "an update finished less than $((HOST_UPDATE_GAP / 60)) minutes ago; try again later"
        warn "host request $id: refused, the last update finished less than $((HOST_UPDATE_GAP / 60)) min ago"; return 1
      fi
      arg="$version" ;;
    local-server)
      url="$(json_field install_url "$raw" || true)"
      valid_install_url "$url" || { host_status "$id" local-server failed "" "$(now_iso)" "" "install_url must be $(env_get FALAK_URL)/install/<token>"; warn "host request $id: invalid install_url"; return 1; }
      # The panel acts as root on every server it manages; on this machine only once root said so.
      if ! local_server_allowed; then
        host_status "$id" local-server failed "" "$(now_iso)" "" "not allowed on this host: run 'sudo falak-ctl local-server allow' first"
        warn "host request $id: local-server is not allowed on this host (falak-ctl local-server allow)"; return 1
      fi
      arg="$url" ;;
    *) host_status "$id" "" failed "" "$(now_iso)" "" "unknown action"; warn "host request $id: unknown action"; return 1 ;;
  esac
  info "host request $id: $action $([ "$action" = update ] && printf '%s' "$version")"
  host_status "$id" "$action" running "$(now_iso)" "" ""
  if [ "$action" = update ]; then
    # The update restarts the control plane and replaces falak-ctl itself: run it in its own transient unit, so
    # nothing tied to falak-host.service (its timeout, a restart of it) can cut it short.
    if command -v systemd-run >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
      systemd-run --quiet --collect --unit "falak-update-$id" --setenv "FALAK_DIR=$FALAK_DIR" --setenv "FALAK_PROJECT=$FALAK_PROJECT" \
        "$(ctl_path)" host-job "$id" update "$arg" \
        || { host_status "$id" update failed "" "$(now_iso)" "" "systemd-run failed"; return 1; }
    else
      setsid "$(ctl_path)" host-job "$id" update "$arg" </dev/null >/dev/null 2>&1 &
    fi
    return 0
  fi
  cmd_host_job "$id" "$action" "$arg"
}

cmd_host_run() {
  ensure_host_dir
  if command -v flock >/dev/null 2>&1; then
    exec 8>>"$HOST_LOCK"
    flock -w 600 8 || die "another host-run is still busy after 600s"
  fi
  host_reap_stuck
  # Requests that land while one runs are taken in the same pass (PathChanged may not fire again for them).
  while [ -e "$HOST_DIR/request.json" ] || [ -L "$HOST_DIR/request.json" ]; do
    host_take || true
  done
}

# host_reap_stuck : an update status.json still says running, but its unit is gone (reboot, killed job) and nothing holds
# the falak-ctl lock: it ends failed, so the panel stops waiting. (status.json is root's: the panel can't fake one.)
host_reap_stuck() {
  local st id started
  [ -f "$HOST_DIR/status.json" ] && [ ! -L "$HOST_DIR/status.json" ] || return 0
  st="$(head -c 4096 "$HOST_DIR/status.json")"
  [ "$(json_field state "$st" || true)" = running ] && [ "$(json_field action "$st" || true)" = update ] || return 0
  id="$(json_field id "$st" || true)"
  valid_request_id "$id" || return 0
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "falak-update-$id.service" 2>/dev/null; then return 0; fi
  if command -v flock >/dev/null 2>&1; then
    # A running update holds .ctl.lock (also through the ensure-host it runs itself).
    ( flock -n 7 ) 7>>"$FALAK_DIR/.ctl.lock" || return 0
  fi
  started="$(json_field started_at "$st" || true)"
  [[ "$started" =~ ^[0-9T:Z-]+$ ]] || started=""
  host_status "$id" update failed "$started" "$(now_iso)" "" "interrupted (the host restarted or the job died)"
  warn "host request $id: the update was interrupted; marked failed"
}

# cmd_host_job ID ACTION ARG : runs a request host-run validated (checked again here); output -> ID.log
cmd_host_job() {
  local id="${1:-}" action="${2:-}" arg="${3:-}" started rc tmp
  valid_request_id "$id" || die "host-job: invalid id"
  case "$action" in
    update) valid_version "$arg" || die "host-job: invalid version" ;;
    local-server) valid_install_url "$arg" || die "host-job: invalid install URL" ;;
    *) die "host-job: unknown action" ;;
  esac
  ensure_host_dir
  started="$(now_iso)"
  tmp="$(host_new_file "$id.log")"
  exec 3>>"$tmp"
  mv -f "$tmp" "$HOST_DIR/$id.log"
  host_status "$id" "$action" running "$started" "" ""
  set +e
  case "$action" in
    update) FALAK_DIR="$FALAK_DIR" FALAK_PROJECT="$FALAK_PROJECT" "$(ctl_path)" update --version "$arg" >&3 2>&1 ;;
    local-server) FALAK_DIR="$FALAK_DIR" FALAK_PROJECT="$FALAK_PROJECT" "$(ctl_path)" local-server enable --install-url "$arg" >&3 2>&1 ;;
  esac
  rc=$?
  set -e
  exec 3>&-
  if [ "$action" = update ]; then
    tmp="$(mktemp "$STATE_DIR/.host-last-update.XXXXXX")"; date +%s > "$tmp"; mv -f "$tmp" "$HOST_LAST_UPDATE"
  fi
  if [ "$rc" = 0 ]; then host_status "$id" "$action" succeeded "$started" "$(now_iso)" 0
  else host_status "$id" "$action" failed "$started" "$(now_iso)" "$rc"; fi
  host_prune_logs '[0-9A-Za-z]{26}\.log'
  return "$rc"
}

host_install_units() {
  local dir ctl changed=0
  command -v systemctl >/dev/null 2>&1 || { warn "no systemctl here: the panel can't ask this host for updates"; return 0; }
  dir="$(systemd_dir)"; ctl="$(ctl_path)"
  mkdir -p "$dir"
  write_unit "$dir/falak-host.path" "[Unit]
Description=Falak panel requests to this host ($HOST_DIR/request.json)

[Path]
PathChanged=$HOST_DIR/request.json
PathExists=$HOST_DIR/request.json
Unit=falak-host.service

[Install]
WantedBy=multi-user.target" && changed=1
  write_unit "$dir/falak-host.service" "[Unit]
Description=Falak host request from the panel (falak-ctl host-run: update, local-server)
After=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=FALAK_DIR=$FALAK_DIR FALAK_PROJECT=$FALAK_PROJECT
ExecStart=$ctl host-run
TimeoutStartSec=1h" && changed=1
  if [ "$changed" = 1 ]; then systemctl daemon-reload || warn "systemctl daemon-reload failed"; fi
  if ! systemctl enable --now falak-host.path >/dev/null 2>&1; then
    warn "could not enable falak-host.path (systemctl status falak-host.path)"; return 0
  fi
  host_write_channel
}

# channel.json: the panel offers its host buttons (update; This machine when local_server_allowed) only once it exists.
host_write_channel() {
  local tmp allowed=false
  if local_server_allowed; then allowed=true; fi
  ensure_host_dir
  tmp="$(host_new_file channel.json)"
  printf '{"version":%s,"units":true,"installed_at":%s,"local_server_allowed":%s}\n' \
    "$(json_str "$(env_get FALAK_VERSION)")" "$(json_str "$(now_iso)")" "$allowed" > "$tmp"
  mv -f "$tmp" "$HOST_DIR/channel.json"
}

# --- resource slices: the panel keeps its share of the machine (spec §4) --------------------------------------
# falakcp.slice (top level: a dash would nest it under falak.slice) holds every control-plane container but the builder:
# MemoryMin protects FALAK_CP_RESERVE_MB (default 1536) from reclaim, CPUWeight 1000 wins any CPU contention. With a
# local server, falak.slice (the agent's workloads, and the builder) is capped at total - reserve and cores - 1.
# Needs Docker's systemd cgroup driver (cgroup_parent names a slice); with another driver the slices are skipped.
mem_total_mb() { awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' /proc/meminfo 2>/dev/null; }
cpu_cores() { nproc 2>/dev/null || getconf _NPROCESSORS_ONLN; }
cp_reserve_mb() {
  local r total
  r="$(env_get FALAK_CP_RESERVE_MB 1536)"; total="$(mem_total_mb)"
  case "$r" in '' | *[!0-9]*) warn "FALAK_CP_RESERVE_MB=$r is not a number; using 1536"; r=1536 ;; esac
  if [ -n "$total" ] && [ "$r" -ge "$total" ]; then r=$((total / 2)); fi
  printf '%s' "$r"
}
env_put() { if [ "$(env_get "$1")" != "$2" ] || ! grep -qE "^$1=" "$ENV_FILE"; then env_set "$1" "$2"; fi; }
workload_tasks_max() { # 80 % of the kernel's task limit, min(pid_max, threads-max); 16384 when unreadable
  local m t
  m="$(cat /proc/sys/kernel/pid_max 2>/dev/null || true)"; t="$(cat /proc/sys/kernel/threads-max 2>/dev/null || true)"
  if [[ "$t" =~ ^[0-9]+$ ]] && { ! [[ "$m" =~ ^[0-9]+$ ]] || [ "$t" -lt "$m" ]; }; then m="$t"; fi
  if [[ "$m" =~ ^[0-9]+$ ]] && [ "$m" -ge 1000 ]; then printf '%s' $((m * 80 / 100)); else printf '16384'; fi
}
docker_systemd_driver() { [ "$(docker info --format '{{.CgroupDriver}}' 2>/dev/null || true)" = systemd ]; }
cgroup_recursiveprot() { grep -E '^cgroup2 ' /proc/mounts 2>/dev/null | grep -q memory_recursiveprot; }
local_edge_enabled() { [ "$(env_get FALAK_LOCAL_EDGE)" = 1 ]; }

ensure_slices() {
  local dir reserve total cores cpus driver changed=0 work
  dir="$(systemd_dir)"; reserve="$(cp_reserve_mb)"; total="$(mem_total_mb)"; cores="$(cpu_cores)"
  [[ "$total" =~ ^[0-9]+$ ]] || die "could not read the memory size (MemTotal in /proc/meminfo)"
  [[ "$cores" =~ ^[0-9]+$ ]] || die "could not read the CPU count (nproc)"
  cpus=$((cores - 1)); [ "$cpus" -ge 1 ] || cpus=1
  # Docker refuses more CPUs than the machine has: recomputed when unset, not a number or above cores - 1 (a resize).
  local bc
  bc="$(env_get FALAK_BUILDER_CPUS)"
  if ! [[ "$bc" =~ ^[0-9]+$ ]] || [ "$bc" -lt 1 ] || [ "$bc" -gt "$cpus" ]; then env_set FALAK_BUILDER_CPUS "$cpus"; fi
  driver="$(docker info --format '{{.CgroupDriver}}' 2>/dev/null || true)"
  if [ "$driver" != systemd ]; then
    warn "Docker's cgroup driver is ${driver:-unknown}, not systemd: no falakcp.slice / falak.slice (per-container limits still apply)"
    env_put FALAK_CP_SLICE ""; env_put FALAK_BUILDER_SLICE ""
    return 0
  fi
  mkdir -p "$dir"
  write_unit "$dir/falakcp.slice" "[Unit]
Description=Falak control plane (reserved share of this machine)
Before=slices.target

[Slice]
MemoryMin=${reserve}M
CPUWeight=1000
IOWeight=500
ManagedOOMPreference=avoid" && changed=1
  if local_edge_enabled; then
    work=$((total - reserve))
    mkdir -p "$dir/falak.slice.d"
    write_unit "$dir/falak.slice.d/50-host-cap.conf" "# falak-ctl local-server: sites and builds on the control-plane machine leave it ${reserve} MB, one core and a fifth
# of the process ids (a fork bomb in a site can't starve the panel).
[Slice]
MemoryMax=${work}M
MemoryHigh=$((work * 95 / 100))M
MemorySwapMax=0
CPUQuota=$((cpus * 100))%
CPUWeight=100
IOWeight=50
TasksMax=$(workload_tasks_max)" && changed=1
    env_put FALAK_BUILDER_SLICE falak.slice
  else
    if [ -f "$dir/falak.slice.d/50-host-cap.conf" ]; then rm -f "$dir/falak.slice.d/50-host-cap.conf"; changed=1; fi
    env_put FALAK_BUILDER_SLICE ""
  fi
  env_put FALAK_CP_SLICE falakcp.slice
  if command -v systemctl >/dev/null 2>&1; then
    if [ "$changed" = 1 ]; then systemctl daemon-reload || warn "systemctl daemon-reload failed"; fi
    systemctl start falakcp.slice >/dev/null 2>&1 || warn "could not start falakcp.slice"
  fi
  ok "falakcp.slice reserves ${reserve} MB for the control plane$(local_edge_enabled && printf '; falak.slice capped at %s MB, %s%% CPU' "$((total - reserve))" "$((cpus * 100))")"
}

# ensure-host: host directory, units and slices, as this version of falak-ctl writes them (install, up, update).
# v0.26: the project moved from the OthmanHaba account to the falak-sh GitHub organization. Installs still naming the
# old release repository or image registry follow it (the old images stay pullable; v0.25.1 is copied to the new
# registry, so a rollback finds it there too). Runs from the new falak-ctl's ensure-host, before update pulls.
ensure_org_move() {
  local key value version
  version="$(env_get FALAK_VERSION)"
  for key in FALAK_REPO FALAK_IMAGE_PREFIX FALAK_DB_IMAGE_REGISTRY; do
    value="$(env_get "$key")"
    case "${value,,}" in
      othmanhaba/falak) env_set "$key" "falak-sh/falak" ;;
      ghcr.io/othmanhaba)
        # Only once the new registry serves this version: until then the install keeps pulling from the old one.
        if ! docker manifest inspect "ghcr.io/falak-sh/falak-control-plane:$version" >/dev/null 2>&1; then
          warn "$key stays $value: ghcr.io/falak-sh does not serve falak-control-plane:$version yet"
          continue
        fi
        env_set "$key" "ghcr.io/falak-sh" ;;
      *) continue ;;
    esac
    info "$key: $value -> $(env_get "$key") (the project moved to github.com/falak-sh)"
  done
}

cmd_ensure_host() {
  require_install
  ensure_org_move
  ensure_host_dir
  host_reap_stuck
  ensure_edge_ip
  ensure_slices
  host_install_units
  if local_edge_enabled; then
    # The stack's networks or the edge address may have changed (the agent re-reads the file on every apply).
    write_local_edge_env || warn "could not refresh $LOCAL_EDGE_ENV (stack down?); it keeps its last values"
    ensure_agent_edge_dropin
  fi
}

# edge_ip_of SUBNET -> the .250 address of an IPv4 subnet of /24 or larger (Docker hands out addresses from the
# bottom, so the edge's fixed one never collides); nothing for anything else.
edge_ip_of() {
  [[ "$1" =~ ^([0-9]+\.[0-9]+\.[0-9]+)\.[0-9]+/([0-9]+)$ ]] || return 1
  [ "${BASH_REMATCH[2]}" -ge 8 ] && [ "${BASH_REMATCH[2]}" -le 24 ] || return 1
  printf '%s.250' "${BASH_REMATCH[1]}"
}

# FALAK_EDGE_IP: the edge's fixed address on the edge network. The app trusts forwarded headers and the client-cert
# fingerprint only from it, and the local server's agent edge accepts PROXY protocol only from it.
ensure_edge_ip() {
  local subnet ip
  subnet="$(env_get FALAK_EDGE_SUBNET 10.213.77.0/24)"
  if ip="$(edge_ip_of "$subnet")"; then
    env_put FALAK_EDGE_IP "$ip"
  else
    warn "FALAK_EDGE_SUBNET=$subnet is not an IPv4 /8../24: no fixed edge address, the whole subnet stays trusted"
    env_put FALAK_EDGE_IP ""
  fi
}

project_subnets() { # comma-separated IPv4 subnets of every network of the compose project (the agent takes IPv4 only)
  local ids
  ids="$(docker network ls -q --filter "label=com.docker.compose.project=$FALAK_PROJECT" 2>/dev/null || true)"
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086  # network ids
  docker network inspect --format '{{range .IPAM.Config}}{{.Subnet}}{{"\n"}}{{end}}' $ids 2>/dev/null \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$' | sort -u | paste -sd, -
}

# --- local server: sites on the control-plane machine ------------------------------------------------------
# The agent enrols like on any server; its edge listens on the edge network's gateway (8443/8080, PROXY protocol from
# the edge network only), and the control-plane edge passes it every host it does not serve itself.
cmd_local_server() {
  require_install
  local sub="${1:-status}" url=""
  shift || true
  case "$sub" in
    enable)
      while [ $# -gt 0 ]; do
        case "$1" in
          --install-url) url="${2:-}"; shift ;;
          --install-url=*) url="${1#--install-url=}" ;;
          *) die "local-server enable: unknown option $1" ;;
        esac
        shift
      done
      valid_install_url "$url" || die "local-server enable: --install-url must be $(env_get FALAK_URL)/install/<token> (Servers → Add server → This machine)"
      local_server_enable "$url" ;;
    disable) local_server_disable ;;
    status) local_server_status ;;
    allow|deny)
      [ "$(id -u)" = 0 ] || die "local-server $sub must run as root"
      if [ "$sub" = allow ]; then env_set FALAK_HOST_ALLOW_LOCAL_SERVER 1; else env_set FALAK_HOST_ALLOW_LOCAL_SERVER 0; fi
      if [ -f "$(systemd_dir)/falak-host.path" ]; then host_write_channel; fi
      if [ "$sub" = allow ]; then
        ok "the panel may make this machine a server (Servers → Add server → This machine): it then acts as root here, as on every server it manages"
      else
        ok "the panel can't make this machine a server (falak-ctl local-server allow to change it)"
      fi ;;
    *) die "usage: falak-ctl local-server enable --install-url URL | disable | status | allow | deny" ;;
  esac
}

edge_network() { # -> "GATEWAY SUBNET" of the compose edge network
  local gw subnet
  read -r gw subnet < <(docker network inspect --format '{{range .IPAM.Config}}{{.Gateway}} {{.Subnet}}{{"\n"}}{{end}}' "${FALAK_PROJECT}_edge" 2>/dev/null | grep -E '^[0-9.]* ?[0-9.]+/[0-9]+$' | head -1) || true
  [ -n "${subnet:-}" ] || return 1
  [ -n "${gw:-}" ] || gw="${subnet%.*}.1"
  printf '%s %s' "$gw" "$subnet"
}

# write_local_edge_env : (re)writes local-edge.env from the running stack and the edge upstreams in .env; 1 (with a
# warning, nothing changed) when the stack's networks can't be read.
write_local_edge_env() {
  local net gw subnet tmp edge_ip protect
  ensure_edge_ip
  edge_ip="$(env_get FALAK_EDGE_IP)"
  [ -n "$edge_ip" ] || { warn "the edge has no fixed address (FALAK_EDGE_SUBNET must be an IPv4 /24 or larger)"; return 1; }
  net="$(edge_network)" || { warn "could not read the ${FALAK_PROJECT}_edge network (is the stack up? falak-ctl up)"; return 1; }
  gw="${net% *}"; subnet="${net#* }"
  [[ "$gw" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { warn "unexpected edge network gateway '$gw'"; return 1; }
  protect="$(project_subnets)"
  [ -n "$protect" ] || { warn "could not list the subnets of the $FALAK_PROJECT networks (is the stack up? falak-ctl up)"; return 1; }
  install -d -m 0755 "$(dirname "$LOCAL_EDGE_ENV")"
  tmp="$(mktemp "$(dirname "$LOCAL_EDGE_ENV")/.local-edge.XXXXXX")"
  # TRUST/PANEL: PROXY protocol only from the panel's edge. PROTECT: the control plane's networks, which the agent keeps
  # the sites' traffic out of (except PANEL_PORTS on PANEL).
  printf '# Written by falak-ctl local-server enable / ensure-host: the agent on the control-plane machine (read by falak-agent).\nFALAK_LOCAL_EDGE=1\nFALAK_LOCAL_EDGE_ADDR=%s\nFALAK_LOCAL_EDGE_HTTP_PORT=8080\nFALAK_LOCAL_EDGE_HTTPS_PORT=8443\nFALAK_LOCAL_EDGE_TRUST=%s/32\nFALAK_LOCAL_EDGE_PANEL=%s\nFALAK_LOCAL_EDGE_PANEL_PORTS=%s,%s\nFALAK_LOCAL_EDGE_PROTECT=%s\nFALAK_PROJECT_NAME=%s\nFALAK_WORKLOAD_SLICE=falak.slice\n' \
    "$gw" "$edge_ip" "$edge_ip" "$(env_get FALAK_HTTP_PORT 80)" "$(https_port)" "$protect" "$FALAK_PROJECT" > "$tmp"
  chmod 644 "$tmp"
  if cmp -s "$tmp" "$LOCAL_EDGE_ENV"; then rm -f "$tmp"; else mv -f "$tmp" "$LOCAL_EDGE_ENV"; ok "wrote $LOCAL_EDGE_ENV"; fi
  env_put FALAK_LOCAL_EDGE_UPSTREAM_HTTPS "$gw:8443"
  env_put FALAK_LOCAL_EDGE_UPSTREAM_HTTP "$gw:8080"
}

# The agent's edge listens on the docker gateway address, which exists only once Docker is up: start after it, and keep
# retrying instead of giving up after systemd's start limit.
AGENT_EDGE_DROPIN_NAME="falak-edge.service.d/10-local-edge.conf"
ensure_agent_edge_dropin() {
  local f
  f="$(systemd_dir)/$AGENT_EDGE_DROPIN_NAME"
  mkdir -p "$(dirname "$f")"
  if write_unit "$f" "# falak-ctl local-server: the local edge binds the edge network's gateway (created by Docker).
[Unit]
After=docker.service
Wants=docker.service
StartLimitIntervalSec=0

[Service]
RestartSec=5"; then
    if command -v systemctl >/dev/null 2>&1; then systemctl daemon-reload || warn "systemctl daemon-reload failed"; fi
  fi
}

local_server_enable() {
  local url="$1" tmp total reserve token
  [ "$(id -u)" = 0 ] || die "local-server enable must run as root"
  docker_systemd_driver || die "local-server needs Docker's systemd cgroup driver (docker info -f '{{.CgroupDriver}}'): without it nothing keeps them off the panel's share"
  total="$(mem_total_mb)"; reserve="$(cp_reserve_mb)"
  if [ -n "$total" ] && [ $((total - reserve)) -lt 512 ]; then
    die "this machine has ${total} MB; with ${reserve} MB reserved for the control plane less than 512 MB is left for sites"
  fi
  write_local_edge_env || die "could not write $LOCAL_EDGE_ENV (see above)"
  info "Sites on this machine (local edge on $(env_get FALAK_LOCAL_EDGE_UPSTREAM_HTTPS) / $(env_get FALAK_LOCAL_EDGE_UPSTREAM_HTTP))"
  env_set FALAK_LOCAL_EDGE 1
  ensure_slices
  ensure_agent_edge_dropin
  # --wait: the install script is fetched through this edge right below.
  compose up -d --wait --wait-timeout 120 --no-deps edge builder >/dev/null || die "recreating the edge failed (falak-ctl logs edge)"
  ok "edge passes every host it does not serve itself to the local edge"
  info "Enrolling this machine's agent"
  token="${url##*/install/}"
  tmp="$(tmpdir)"
  # Through the local edge (works before DNS, and with FALAK_TLS=internal).
  edge_curl "$(env_get FALAK_DOMAIN)" "/install/$token" -f --retry 10 --retry-connrefused --retry-all-errors --retry-delay 2 -o "$tmp/install.sh" \
    || die "downloading the install script failed"
  sh "$tmp/install.sh" </dev/null || die "the install script failed (see above); retry from the panel or: falak-ctl local-server enable --install-url …"
  ok "this machine is a server now: deploy sites to it from the panel"
}

local_server_disable() {
  [ "$(id -u)" = 0 ] || die "local-server disable must run as root"
  rm -f "$LOCAL_EDGE_ENV"
  env_set FALAK_LOCAL_EDGE ""
  env_set FALAK_LOCAL_EDGE_UPSTREAM_HTTPS ""
  env_set FALAK_LOCAL_EDGE_UPSTREAM_HTTP ""
  ensure_slices
  if [ -f "$(systemd_dir)/$AGENT_EDGE_DROPIN_NAME" ]; then
    rm -f "$(systemd_dir)/$AGENT_EDGE_DROPIN_NAME"
    if command -v systemctl >/dev/null 2>&1; then systemctl daemon-reload || warn "systemctl daemon-reload failed"; fi
  fi
  compose up -d --wait --wait-timeout 120 --no-deps edge builder >/dev/null || die "recreating the edge failed (falak-ctl logs edge)"
  ok "the edge serves only the control plane again; $LOCAL_EDGE_ENV removed"
  warn "the agent and its sites stay installed, but no request reaches them on 80/443 any more."
  say "  Move the sites to another server, then delete this machine in the panel (Servers → this machine → Delete)."
}

local_server_status() {
  if local_edge_enabled; then
    say "local server: enabled (edge upstreams $(env_get FALAK_LOCAL_EDGE_UPSTREAM_HTTPS), $(env_get FALAK_LOCAL_EDGE_UPSTREAM_HTTP))"
    if [ -f "$LOCAL_EDGE_ENV" ]; then grep -v '^#' "$LOCAL_EDGE_ENV" | sed 's/^/  /'; else warn "$LOCAL_EDGE_ENV is missing (falak-ctl local-server enable again)"; fi
    if command -v systemctl >/dev/null 2>&1; then
      say "  falak.slice: $(systemctl show falak.slice -p MemoryMax -p CPUQuotaPerSecUSec 2>/dev/null | tr '\n' ' ')"
    fi
  else
    say "local server: disabled (enable: Servers → Add server → This machine, or falak-ctl local-server enable --install-url …)"
  fi
  if local_server_allowed; then say "  the panel may ask for it (local-server deny to refuse)"; else say "  the panel may not ask for it (local-server allow)"; fi
  if command -v systemctl >/dev/null 2>&1; then
    say "  falakcp.slice: $(systemctl show falakcp.slice -p MemoryMin -p CPUWeight 2>/dev/null | tr '\n' ' ')"
  fi
  # Without memory_recursiveprot the panel's containers inside falakcp.slice don't inherit its MemoryMin.
  cgroup_recursiveprot || warn "cgroup2 is not mounted with memory_recursiveprot (systemd < 248?): falakcp.slice's MemoryMin does not reach the panel's containers"
}

ask() { # ask VAR PROMPT [default] : read a line from the terminal into VAR (default when empty)
  local answer
  printf '  %s%s: ' "$2" "${3:+ [$3]}" >&2
  IFS= read -r answer || true
  printf -v "$1" '%s' "${answer:-${3:-}}"
}

ask_secret() { # ask_secret VAR PROMPT : read without echo
  local answer
  printf '  %s: ' "$2" >&2
  IFS= read -rs answer || true
  printf '\n' >&2
  printf -v "$1" '%s' "$answer"
}

read_secret_file() { # read_secret_file FILE -> first line, no trailing newline
  [ -r "$1" ] || die "cannot read $1"
  head -1 "$1" | tr -d '\r\n'
}

cmd_dr() {
  require_install
  local sub="${1:-}"; shift || true
  case "$sub" in
    setup) dr_setup "$@" ;;
    status) dr_status "$@" ;;
    drill) dr_drill "$@" ;;
    *) die "usage: falak-ctl dr setup [options] | status [--json] | drill [--local] [--backup FILE]" ;;
  esac
}

dr_setup_usage() {
  cat <<'EOF'
usage: falak-ctl dr setup [options]   (asks for anything missing when run in a terminal)

  --endpoint URL           S3 endpoint, e.g. https://s3.eu-central-1.amazonaws.com, https://<account>.r2.cloudflarestorage.com
  --bucket NAME            bucket for the control plane's backups (keep it apart from the servers' backups)
  --region REGION          default us-east-1 (R2: auto)
  --prefix PREFIX          key prefix, default falak
  --access-key ID          access key id
  --secret-key-file FILE   file holding the secret key (or FALAK_BACKUP_S3_SECRET_KEY in the environment)
  --passphrase-file FILE   file holding the DR passphrase (or FALAK_BACKUP_PASSPHRASE in the environment);
                           at least 12 characters. Every upload is encrypted with it: store it in a password manager
  --every HOURS            backup schedule: 1, 2, 3, 4, 6 (default), 8, 12 or 24
  --drill monthly|off      restore drill from a timer (default monthly)
  --include-registry       also back up the built-in image registry (registry-data; can be large)
  --no-registry            leave the registry out (default)
  --skip-check             don't test the bucket (write, list) before saving
  --yes                    never prompt (missing settings are an error)
EOF
}

dr_setup() {
  DR_ENV_FALLBACK=1
  local endpoint bucket region prefix access secret="" pass="" every drill registry check=1 prompt=1 file
  endpoint="$(dr_get FALAK_BACKUP_S3_ENDPOINT)"; bucket="$(dr_get FALAK_BACKUP_S3_BUCKET)"
  region="$(dr_get FALAK_BACKUP_S3_REGION us-east-1)"; prefix="$(dr_get FALAK_BACKUP_S3_PREFIX falak)"
  access="$(dr_get FALAK_BACKUP_S3_ACCESS_KEY)"; every="$(dr_get FALAK_DR_EVERY_HOURS 6)"
  drill="$(dr_get FALAK_DR_DRILL monthly)"; registry="$(dr_get FALAK_BACKUP_REGISTRY 0)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --endpoint) endpoint="${2:-}"; shift ;;
      --bucket) bucket="${2:-}"; shift ;;
      --region) region="${2:-}"; shift ;;
      --prefix) prefix="${2:-}"; shift ;;
      --access-key) access="${2:-}"; shift ;;
      --secret-key-file) file="${2:-}"; shift; secret="$(read_secret_file "$file")" ;;
      --passphrase-file) file="${2:-}"; shift; pass="$(read_secret_file "$file")" ;;
      --every) every="${2:-}"; shift ;;
      --drill) drill="${2:-}"; shift ;;
      --include-registry) registry=1 ;;
      --no-registry) registry=0 ;;
      --skip-check) check=0 ;;
      --yes|-y) prompt=0 ;;
      --secret-key|--passphrase) die "$1 would show the secret in the process list: use ${1}-file FILE or the environment" ;;
      -h|--help) dr_setup_usage; return 0 ;;
      *) dr_setup_usage >&2; die "dr setup: unknown option $1" ;;
    esac
    shift
  done
  [ -n "$secret" ] || secret="$(dr_get FALAK_BACKUP_S3_SECRET_KEY)"
  [ -n "$pass" ] || pass="$(dr_get FALAK_BACKUP_PASSPHRASE)"
  if [ "$prompt" = 1 ] && [ ! -t 0 ]; then prompt=0; fi

  if [ "$prompt" = 1 ]; then
    info "Disaster recovery: where the control plane's encrypted backups go"
    ask endpoint "S3 endpoint (https://…)" "$endpoint"
    ask bucket "Bucket" "$bucket"
    ask region "Region" "$region"
    ask prefix "Key prefix" "$prefix"
    ask access "Access key id" "$access"
    if [ -z "$secret" ]; then ask_secret secret "Secret access key"; fi
    if [ -z "$pass" ]; then
      local again
      say "  The DR passphrase encrypts every backup (and the key-encryption key inside it). Without it a backup"
      say "  can't be restored: store it in a password manager, apart from this host."
      ask_secret pass "DR passphrase (12+ characters)"
      ask_secret again "Repeat it"
      [ "$pass" = "$again" ] || die "the passphrases differ"
    fi
    ask every "Back up every N hours (1, 2, 3, 4, 6, 8, 12, 24)" "$every"
    ask drill "Monthly restore drill (monthly / off)" "$drill"
  fi

  case "$endpoint" in https://*|http://*) ;; *) die "--endpoint must be an http(s) URL (got '${endpoint}')" ;; esac
  [ -n "$bucket" ] || die "--bucket is required"
  printf '%s' "$bucket" | grep -Eq '^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$' || die "--bucket '$bucket' is not a valid bucket name"
  [ -n "$access" ] || die "--access-key is required"
  [ -n "$secret" ] || die "the secret key is required (--secret-key-file FILE or FALAK_BACKUP_S3_SECRET_KEY)"
  [ -n "$pass" ] || die "the DR passphrase is required: uploads are always encrypted (--passphrase-file FILE or FALAK_BACKUP_PASSPHRASE)"
  [ "${#pass}" -ge 12 ] || die "the DR passphrase must have at least 12 characters"
  valid_every "$every" || die "--every $every: use 1, 2, 3, 4, 6, 8, 12 or 24"
  case "$drill" in monthly|off) ;; *) die "--drill must be monthly or off" ;; esac
  prefix="${prefix#/}"; prefix="${prefix%/}"
  case "$prefix" in *[!A-Za-z0-9._/-]*) die "--prefix may only use letters, digits, . _ - /" ;; esac

  local old_pass
  old_pass="$(dr_get FALAK_BACKUP_PASSPHRASE)"
  dr_set FALAK_BACKUP_S3_ENDPOINT "${endpoint%/}"
  dr_set FALAK_BACKUP_S3_BUCKET "$bucket"
  dr_set FALAK_BACKUP_S3_REGION "$region"
  dr_set FALAK_BACKUP_S3_PREFIX "$prefix"
  dr_set FALAK_BACKUP_S3_ACCESS_KEY "$access"
  dr_set FALAK_BACKUP_S3_SECRET_KEY "$secret"
  dr_set FALAK_BACKUP_PASSPHRASE "$pass"
  dr_set FALAK_DR_EVERY_HOURS "$every"
  dr_set FALAK_DR_DRILL "$drill"
  dr_set FALAK_BACKUP_REGISTRY "$registry"
  ok "settings saved to $DR_FILE (mode 600, root only)"
  if [ -n "$old_pass" ] && [ "$old_pass" != "$pass" ]; then
    warn "the DR passphrase changed: backups taken before need the previous one. Keep it until they expire."
  fi

  if [ "$check" = 1 ]; then
    local probe
    probe="$(tmpdir)/check"
    printf 'falak dr check %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$probe"
    s3_put "$probe" "$(s3_prefix).falak-dr-check" || die "writing to s3://$bucket/$(s3_prefix) failed: check the endpoint, bucket, region and keys (settings were saved; re-run dr setup to change them)"
    s3_list "$(s3_prefix)" >/dev/null || die "listing s3://$bucket/$(s3_prefix) failed: the keys need s3:ListBucket (restore finds the latest backup by listing)"
    ok "s3://$bucket/$(s3_prefix) is writable and listable"
  fi

  dr_install_timers
  dr_write_json
  say
  say "  Disaster recovery is configured. Next:"
  say "    falak-ctl backup --upload     first backup now (the timer takes over)"
  say "    falak-ctl dr drill            prove it restores"
  say "  Restoring on a new host needs the bucket settings and the DR passphrase: keep both in your password manager."
}

dr_status() {
  local json=0
  [ "${1:-}" = --json ] && json=1
  dr_write_json
  if [ "$json" = 1 ]; then cat "$DR_JSON"; return 0; fi
  local at now age name every
  now="$(date -u +%s)"; every="$(dr_every_hours)"
  if dr_configured; then ok "configured: s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$(s3_prefix) every $every h, encrypted"
  else
    bad "not configured: run falak-ctl dr setup"
    s3_configured || say "    no DR bucket"
    [ -n "$(dr_get FALAK_BACKUP_PASSPHRASE)" ] || say "    no DR passphrase (uploads must be encrypted)"
    [ -f "$(systemd_dir)/falak-backup.timer" ] || say "    no falak-backup.timer"
  fi
  name="$(state_get backup_name)"; at="$(state_get backup_at)"
  if [ -n "$name" ]; then
    age=$((now - $(iso_epoch "$at")))
    local line
    line="last backup: $name, $(human_age "$age") ago, $(state_get backup_size) bytes, $([ "$(state_get backup_uploaded)" = 1 ] && echo uploaded || echo 'local only')"
    if [ "$age" -gt $((every * 2 * 3600)) ]; then warn "$line (older than twice the schedule)"; else ok "$line"; fi
  else warn "no backup recorded yet"; fi
  at="$(state_get failure_at)"
  if [ -n "$at" ] && [ "$(iso_epoch "$at")" -gt "$(iso_epoch "$(state_get backup_at)")" ]; then
    bad "last scheduled backup failed at $at: $(state_get failure_error)"
  fi
  at="$(state_get drill_at)"
  if [ -z "$at" ]; then warn "no restore drill yet: falak-ctl dr drill"
  elif [ "$(state_get drill_ok)" = 1 ]; then ok "last drill passed $at ($(state_get drill_backup), $(state_get drill_duration) s)"
  else bad "last drill FAILED $at: $(state_get drill_message)"; fi
}

dr_doctor() { # warnings only: not configured, the last backup too old or failed, the last drill failed
  local now at every n=0
  now="$(date -u +%s)"; every="$(dr_every_hours)"
  if ! dr_configured; then
    warn "disaster recovery is not configured: backups stay on this host. Run falak-ctl dr setup"
    return 1
  fi
  ok "disaster recovery: s3://$(dr_get FALAK_BACKUP_S3_BUCKET)/$(s3_prefix), every $every h, encrypted"
  at="$(state_get backup_at)"
  if [ -z "$at" ]; then warn "no scheduled backup recorded yet (systemctl status falak-backup.timer)"; n=1
  elif [ $((now - $(iso_epoch "$at"))) -gt $((every * 2 * 3600)) ]; then
    warn "the last backup ($at) is older than twice the schedule (journalctl -u falak-backup)"; n=1
  fi
  at="$(state_get failure_at)"
  if [ -n "$at" ] && [ "$(iso_epoch "$at")" -gt "$(iso_epoch "$(state_get backup_at)")" ]; then
    warn "the last scheduled backup failed ($at): $(state_get failure_error)"; n=1
  fi
  if [ -n "$(drill_leftovers)" ] && { ! command -v flock >/dev/null 2>&1 || flock -n "$FALAK_DIR/.ctl.lock" true; }; then
    warn "containers of an interrupted restore drill are left ($(drill_project)): the next falak-ctl dr drill removes them"; n=1
  fi
  if [ "$(state_get drill_ok)" = 0 ]; then warn "the last restore drill failed: $(state_get drill_message)"; n=1
  elif [ -z "$(state_get drill_at)" ]; then warn "no restore drill yet: falak-ctl dr drill"; n=1; fi
  [ "$n" = 0 ]
}

# --- the drill: the latest backup restored into a throwaway stack ----------------------------------------
# Compose project "<project>-drill" in $FALAK_DIR/drill (its own .env, secrets, volumes, networks and edge subnet):
# postgres, valkey and the control plane only — no edge, workers or scheduler, so nothing in it talks to servers,
# sends mail or binds a public port. Torn down (volumes included) whatever the outcome.
drill_project() { printf '%s-drill' "$FALAK_PROJECT"; }
drill_dir() { printf '%s/drill' "$FALAK_DIR"; }

drill_subnet() { # an edge subnet that is not the install's
  local want="${FALAK_DRILL_SUBNET:-10.213.78.0/24}"
  if [ "$want" = "$(env_get FALAK_EDGE_SUBNET 10.213.77.0/24)" ]; then want="10.213.79.0/24"; fi
  printf '%s' "$want"
}

# drill_switch DIR : every path and the compose project point at the drill (call in a subshell).
drill_switch() {
  # shellcheck disable=SC2034  # read by the functions the drill calls
  {
    FALAK_PROJECT="$(drill_project)"
    FALAK_DIR="$1"
    ENV_FILE="$1/.env"
    COMPOSE_FILE="$1/deploy/compose.yml"
    BACKUP_DIR="$1/backups"
    SECRETS_DIR="$1/secrets"
    KEK_FILE="$1/secrets/kek"
    KEK_PREVIOUS="$1/secrets/kek.previous"
    STATE_DIR="$1/state"
  }
  case "$FALAK_PROJECT" in *-drill) ;; *) die "refusing to run a drill in project $FALAK_PROJECT" ;; esac
}

# drill_prepare WORK DIR : the drill's install directory from the extracted backup and this host's bundle.
drill_prepare() {
  local work="$1" dir="$2" version prefix repo subnet
  version="$(env_get FALAK_VERSION)"; prefix="$(env_get FALAK_IMAGE_PREFIX)"; repo="$(env_get FALAK_REPO)"; subnet="$(drill_subnet)"
  rm -rf "$dir"
  install -d -m 0700 "$dir"
  cp -R "$FALAK_DIR/deploy" "$dir/deploy"
  if [ -d "$FALAK_DIR/observability" ]; then cp -R "$FALAK_DIR/observability" "$dir/observability"; fi
  install -d -m 0711 "$dir/secrets"
  install -d -m 0755 "$dir/state"
  grep -vE '^[[:space:]]*(export[[:space:]]+)?(COMPOSE_|DOCKER_)' "$work/env" > "$dir/.env" || true
  chmod 600 "$dir/.env"
  if [ -f "$work/custom.env" ]; then install -m 600 "$work/custom.env" "$dir/custom.env"; fi
  # Nothing in the drill comes back by itself after a reboot or a crash of falak-ctl.
  sed -i.orig 's/^\([[:space:]]*\)restart: unless-stopped/\1restart: "no"/' "$dir/deploy/compose.yml" && rm -f "$dir/deploy/compose.yml.orig"
  if [ -f "$work/secrets/kek" ]; then
    install -m 0400 "$work/secrets/kek" "$dir/secrets/kek"
    if [ -f "$work/secrets/kek.previous" ]; then install -m 0400 "$work/secrets/kek.previous" "$dir/secrets/kek.previous"; fi
  elif [ "$(kek_provider)" = local ]; then
    # Not in the backup (unencrypted): this host's KEKs, which restore_kek_check found to be the ones it needs.
    if [ -f "$KEK_FILE" ]; then install -m 0400 "$KEK_FILE" "$dir/secrets/kek"; fi
    if [ -f "$KEK_PREVIOUS" ]; then install -m 0400 "$KEK_PREVIOUS" "$dir/secrets/kek.previous"; fi
  fi
  (
    drill_switch "$dir"
    # This host's images (nothing pulled), another subnet, no public ports, no observability profile.
    env_set FALAK_VERSION "$version"
    env_set FALAK_IMAGE_PREFIX "$prefix"
    env_set FALAK_REPO "$repo"
    env_set FALAK_DEPLOY_SOURCE ""
    env_set FALAK_PULL 0
    env_set FALAK_EDGE_SUBNET "$subnet"
    env_set FALAK_EDGE_IP "$(edge_ip_of "$subnet" || true)"
    env_set FALAK_HTTP_PORT 18080
    env_set FALAK_HTTPS_PORT 18443
    env_set FALAK_TLS internal
    env_set COMPOSE_PROFILES ""
    local f
    for f in "$SECRETS_DIR/kek" "$SECRETS_DIR/kek.previous"; do
      if [ -f "$f" ]; then kek_secure "$f"; fi
    done
  )
}

drill_check() { # drill_check NAME OK DETAIL : one line of the report; counts failures in DRILL_FAILED
  if [ "$2" = 1 ]; then ok "$1: $3"; else bad "$1: $3"; DRILL_FAILED=$((DRILL_FAILED + 1)); DRILL_PROBLEMS="${DRILL_PROBLEMS:+$DRILL_PROBLEMS; }$1: $3"; fi
}

# drill_run BACKUP : restore and check (run in a subshell). Exit status = number of failed checks (0 = passed).
drill_run() {
  local backup="$1" work dir
  work="$(tmpdir)"
  dir="$(drill_dir)"
  extract_backup "$backup" "$work" "${DRILL_EXPECT:-}"
  restore_kek_check "$work" 0
  drill_prepare "$work" "$dir"
  drill_switch "$dir"
  DRILL_FAILED=0; DRILL_PROBLEMS=""

  compose up -d --wait --wait-timeout 300 postgres valkey >/dev/null || die "the drill's postgres / valkey did not start"
  restore_database "$work"
  ok "database restored into $FALAK_PROJECT"
  local restored
  restored="$(restore_volumes "$work" falak-ca app-storage)"
  ok "volumes restored: ${restored:-none}"
  # Migrations run when the control plane starts (FALAK_MIGRATE): a failed one keeps it unhealthy.
  if compose up -d --wait --wait-timeout 600 control-plane >/dev/null 2>&1; then
    drill_check "control plane" 1 "started on the restored data (migrations ran)"
  else
    compose logs --tail=30 control-plane 2>/dev/null | sed 's/^/    /' >&2 || true
    drill_check "control plane" 0 "did not become healthy on the restored data"
    printf '%s\n' "$DRILL_PROBLEMS" > "$dir/problems"
    exit "$DRILL_FAILED"
  fi

  local out pending
  if out="$(compose exec -T control-plane php artisan migrate:status --no-interaction 2>&1)"; then
    pending="$(printf '%s\n' "$out" | grep -c 'Pending' || true)"
    if [ "$pending" = 0 ]; then drill_check migrations 1 "all ran"; else drill_check migrations 0 "$pending pending"; fi
  else
    drill_check migrations 0 "migrate:status failed"
  fi

  local report failed keys
  if report="$(keys_check_json)" && printf '%s' "$report" | grep -q '"ok":true'; then
    keys="$(json_number data_keys "$report")"
    drill_check "encryption keys" 1 "the KEK unwraps all ${keys:-?} data keys"
  else
    failed="$(json_number failed "${report:-}")"
    drill_check "encryption keys" 0 "falak:keys:check failed (${failed:-?} data keys don't unwrap: wrong or missing KEK)"
  fi

  local want have pair table count got
  want="$(sed -n 's/^rows=//p' "$work/manifest" 2>/dev/null || true)"
  have="$(row_counts || true)"
  if [ -z "$want" ]; then
    drill_check "row counts" 1 "${have:-none} (the backup recorded none to compare)"
  else
    local diff=""
    for pair in ${want//,/ }; do
      table="${pair%%:*}"; count="${pair#*:}"
      got="$(printf '%s' ",$have," | sed -n "s/.*,$table:\([0-9]*\),.*/\1/p")"
      [ "$got" = "$count" ] || diff="$diff $table ${got:-missing}/$count"
    done
    if [ -z "$diff" ]; then drill_check "row counts" 1 "match the backup (${want//,/, })"; else drill_check "row counts" 0 "differ:$diff"; fi
  fi

  if compose exec -T control-plane test -s /falak/ca/ca.pem >/dev/null 2>&1; then drill_check "Fleet CA" 1 "present"
  else drill_check "Fleet CA" 0 "ca.pem missing (agents could not reconnect)"; fi

  printf '%s\n' "$DRILL_PROBLEMS" > "$dir/problems"
  exit "$DRILL_FAILED"
}

drill_leftovers() { # drill_leftovers -> ids of containers of the drill project (none outside a drill)
  docker ps -aq --filter "label=com.docker.compose.project=$(drill_project)" 2>/dev/null || true
}

drill_teardown() { # drill_teardown : the drill's containers, volumes, networks and directory go (also an earlier run's)
  local dir ids
  dir="$(drill_dir)"
  if [ -d "$dir" ]; then
    (
      drill_switch "$dir"
      if [ -f "$COMPOSE_FILE" ] && [ -f "$ENV_FILE" ]; then compose down -v --remove-orphans >/dev/null 2>&1 || true; fi
    )
  fi
  # Whatever an interrupted run left behind, found by the project label.
  ids="$(drill_leftovers)"
  # shellcheck disable=SC2086  # container ids, one per line
  if [ -n "$ids" ]; then docker rm -f $ids >/dev/null 2>&1 || true; fi
  ids="$(docker volume ls -q --filter "label=com.docker.compose.project=$(drill_project)" 2>/dev/null || true)"
  # shellcheck disable=SC2086
  if [ -n "$ids" ]; then docker volume rm -f $ids >/dev/null 2>&1 || true; fi
  ids="$(docker network ls -q --filter "label=com.docker.compose.project=$(drill_project)" 2>/dev/null || true)"
  # shellcheck disable=SC2086
  if [ -n "$ids" ]; then docker network rm $ids >/dev/null 2>&1 || true; fi
  rm -rf "$dir"
}

dr_drill() {
  local backup="" local_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --local) local_only=1 ;;
      --backup) backup="${2:-}"; shift ;;
      --scheduled) ;;   # from falak-drill.timer: the same run, the outcome goes to state/dr.json either way
      *) die "dr drill: unknown option $1" ;;
    esac
    shift
  done
  info "restore drill ($(drill_project), torn down afterwards)"
  local started dir rc=0 src
  started="$(date -u +%s)"; dir="$(drill_dir)"
  drill_teardown
  local fetched
  fetched="$(tmpdir)"
  if [ -n "$backup" ]; then
    src="$(restore_source "$backup")"
  elif [ "$local_only" = 0 ] && s3_configured; then
    # The drill proves what a lost host would get: the latest upload, downloaded, authenticated and decrypted.
    src="$( (s3_fetch latest "$fetched") )" || src=""
    if [ -n "$src" ]; then DRILL_EXPECT="$(basename "$src" .fdr)"; fi
  else
    src="$(latest_backup)"
  fi
  if [ -z "$src" ] || [ ! -f "$src" ]; then
    state_set "drill_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" drill_ok=0 drill_backup= drill_duration=0 "drill_message=no backup to drill (falak-ctl backup --upload)"
    die "no backup to drill"
  fi
  say "  backup: $(basename "$src")"
  ( trap cleanup EXIT; drill_run "$src" ) || rc=$?
  local problems=""
  if [ -f "$dir/problems" ]; then problems="$(cat "$dir/problems")"; fi
  drill_teardown
  local took=$(( $(date -u +%s) - started ))
  if [ "$rc" = 0 ]; then
    state_set "drill_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" drill_ok=1 "drill_backup=$(basename "$src")" "drill_duration=$took" "drill_message=all checks passed"
    ok "drill passed in ${took}s; $(drill_project) removed"
    return 0
  fi
  state_set "drill_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" drill_ok=0 "drill_backup=$(basename "$src")" "drill_duration=$took" \
    "drill_message=${problems:-the restore did not complete (see falak-ctl output)}"
  bad "drill FAILED${problems:+: $problems}"
  return 1
}

cmd_update() {
  require_install
  local target="" skip_backup=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) target="$2"; shift ;;
      --version=*) target="${1#--version=}" ;;
      --skip-backup) skip_backup=1 ;;
      *) die "update: unknown option $1" ;;
    esac
    shift
  done
  # Everything also goes to state/host/update-<UTC>.log (the panel shows it; the newest 20 are kept).
  local log tmp
  ensure_host_dir
  log="update-$(date -u +%Y%m%dT%H%M%SZ).log"
  tmp="$(host_new_file "$log")"
  exec 4>>"$tmp"; mv -f "$tmp" "$HOST_DIR/$log"
  host_prune_logs 'update-[0-9]{8}T[0-9]{6}Z\.log'
  exec > >(tee /dev/fd/4) 2>&1
  local prev
  prev="$(env_get FALAK_VERSION)"
  if [ -z "$target" ]; then
    target="$(latest_version)"
    [ -n "$target" ] || die "could not determine the latest release (pass --version)"
  fi
  info "update $prev -> $target"

  # 1. backup (the rollback point)
  local backup=""
  if [ "$skip_backup" != 1 ]; then
    cmd_backup --label "pre-update-$prev" --quiet
    backup="$LAST_BACKUP"
    ok "backup $(basename "$backup")"
  fi

  # 2. stage the new deploy bundle, switch version, pull
  local staged
  staged="$(tmpdir)"
  fetch_bundle "$target" "$staged"
  install_bundle "$staged"; rm -rf "$staged"
  env_set FALAK_VERSION "$target"
  ensure_registry_env
  ensure_kek --quiet
  # The new falak-ctl (install_bundle just replaced it) writes its own host units and slices; this process is the
  # old script.
  env FALAK_DIR="$FALAK_DIR" FALAK_PROJECT="$FALAK_PROJECT" bash "$FALAK_DIR/deploy/falak-ctl" ensure-host || warn "falak-ctl ensure-host failed (run it again after the update)"
  if ! pull_images; then
    bad "pulling images for $target failed; nothing was changed"
    env_set FALAK_VERSION "$prev"; restore_prev_bundle
    return 1
  fi
  ok "images for $target ready"

  # 3. restart (web migrates on start; horizon/scheduler/reverb wait for it)
  local failed=0
  if ! wait_healthy 420; then failed=1; fi
  if [ "$failed" = 0 ] && ! health_check; then failed=1; fi
  if [ "$failed" = 0 ]; then
    ok "Falak $target is up"
    after_update_images "$prev" "$target"
    agents_hint
    return 0
  fi

  # 4. rollback
  bad "update to $target failed — rolling back to $prev"
  compose logs --tail=40 control-plane 2>/dev/null | sed 's/^/    /' >&2 || true
  env_set FALAK_VERSION "$prev"
  restore_prev_bundle
  if [ -n "$backup" ]; then
    do_restore "$backup" 0 1 || die "ROLLBACK FAILED: restore $backup manually (falak-ctl restore $backup --yes)"
  else
    if ! wait_healthy 420 || ! health_check; then die "ROLLBACK FAILED: previous version $prev is not healthy"; fi
  fi
  ok "rolled back to $prev"
  return 1
}

# Servers keep their agent until it is upgraded from the panel: say so when the new release ships a newer one.
agents_hint() {
  local n
  n="$(compose exec -T control-plane php artisan falak:agents --outdated --count 2>/dev/null | tr -dc '0-9')"
  if [ -n "$n" ] && [ "$n" -gt 0 ]; then
    warn "$n server agent(s) run an older falak-agent than this release ships."
    say "  Update them in the panel (Servers → Update all agents, or Update per server) or: curl -X POST -H 'Authorization: Bearer …' https://$(env_get FALAK_DOMAIN)/api/v1/servers/<id>/agent/upgrade"
  fi
}

cmd_doctor() {
  require_install
  local domain agents grafana registry port problems=0
  domain="$(env_get FALAK_DOMAIN)"; agents="$(env_get FALAK_AGENT_API_HOST)"; grafana="$(env_get FALAK_GRAFANA_HOST)"
  registry="$(env_get FALAK_REGISTRY_HOST)"
  port="$(https_port)"

  info "DNS"
  local pub4 pub6
  pub4="$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
  pub6="$(curl -6 -fsS --max-time 5 https://api6.ipify.org 2>/dev/null || true)"
  say "  public IPv4: ${pub4:-unknown}   IPv6: ${pub6:-none}"
  local h addrs
  for h in "$domain" "$agents" $grafana $registry; do
    addrs="$(resolve "$h")"
    if [ -z "$addrs" ]; then bad "$h does not resolve"; problems=$((problems + 1))
    elif { [ -n "$pub4" ] && grep -qx "$pub4" <<<"$addrs"; } || { [ -n "$pub6" ] && grep -qx "$pub6" <<<"$addrs"; }; then ok "$h -> $(tr '\n' ' ' <<<"$addrs")"
    else warn "$h -> $(tr '\n' ' ' <<<"$addrs") (not this host's public IP ${pub4:-?})"; problems=$((problems + 1))
    fi
  done

  info "Ports"
  local p
  for p in "$(env_get FALAK_HTTP_PORT 80)" "$port"; do
    if port_listening "$p"; then ok "port $p listening"; else bad "nothing listens on port $p"; problems=$((problems + 1)); fi
  done

  info "Containers"
  health_check || problems=$((problems + 1))

  info "Cookies"
  # The panel's session, CSRF and remember-me cookies are __Host- prefixed only when Secure (APP_URL https): previews
  # on a sibling host could otherwise plant cookies the panel reads.
  case "$(env_get APP_URL "https://$domain")" in
    https://*) ok "panel cookies are __Host- prefixed (host-only, Secure)" ;;
    *) warn "APP_URL is not https: the panel's cookies are not __Host- prefixed (previews could plant cookies)"; problems=$((problems + 1)) ;;
  esac

  info "Certificates"
  local end issuer
  if end="$(cert_field "$domain" -enddate)"; then
    issuer="$(cert_field "$domain" -issuer || true)"
    ok "$domain: ${end#notAfter=} (${issuer#issuer=})"
    # Caddy's internal CA issues 12-hour certificates (FALAK_TLS=internal); ACME renews 30 days ahead.
    if [ "$(env_get FALAK_TLS acme)" = acme ] && ! days_left "${end#notAfter=}" 14; then
      warn "$domain certificate expires within 14 days (renewal failing? falak-ctl logs edge)"; problems=$((problems + 1))
    fi
  else bad "$domain: no TLS certificate served"; problems=$((problems + 1)); fi
  local ca
  ca="$(mktemp)"
  if compose exec -T control-plane cat /falak/ca/ca.pem > "$ca" 2>/dev/null && [ -s "$ca" ]; then
    ok "Fleet CA present ($(openssl x509 -in "$ca" -noout -subject 2>/dev/null | sed 's/subject=//'))"
    if echo | openssl s_client -connect "127.0.0.1:$port" -servername "$agents" -CAfile "$ca" -verify_return_error </dev/null >/dev/null 2>&1; then
      ok "$agents serves a certificate chained to the Fleet CA"
    else bad "$agents does not serve a Fleet-CA certificate"; problems=$((problems + 1)); fi
  else bad "Fleet CA ($FALAK_DIR volume falak-ca/ca.pem) missing"; problems=$((problems + 1)); fi

  info "Agent API"
  local code
  code="$(curl -sS --max-time 10 --cacert "$ca" --resolve "$agents:$port:127.0.0.1" -o /dev/null -w '%{http_code}' "https://$agents:$port/agent/v1/heartbeat" -X POST 2>/dev/null || true)"
  if [ "$code" = 401 ]; then ok "requests without a client certificate are rejected (401)"; else bad "agent API without client cert -> ${code:-no response} (expected 401)"; problems=$((problems + 1)); fi
  code="$(edge_curl "$domain" /install/agent/linux-amd64 -o /dev/null -w '%{http_code}' -r 0-0 2>/dev/null || true)"
  case "$code" in 200|206) ok "agent binaries served (/install/agent/linux-amd64)";; *) bad "agent binary download -> ${code:-no response}"; problems=$((problems + 1));; esac
  rm -f "$ca"

  info "Encryption keys"
  kek_status || problems=$((problems + 1))

  info "Image registry"
  if [ -z "$registry" ]; then
    warn "no built-in registry configured (docker builds cannot push) — run falak-ctl up"; problems=$((problems + 1))
  else
    code="$(registry_code)"
    if [ "$code" = 401 ]; then ok "$registry requires credentials (401 without)"; else bad "$registry without credentials -> ${code:-no response} (expected 401)"; problems=$((problems + 1)); fi
    code="$(registry_code --auth)"
    if [ "$code" = 200 ]; then ok "$registry answers with the credentials (200)"; else bad "$registry with the credentials -> ${code:-no response} (falak-ctl logs registry / edge)"; problems=$((problems + 1)); fi
  fi

  info "PHP threads"
  local svc samples usage busy cap min_busy knob legacy
  for svc in $PHP_POOLS; do
    # Three samples a second apart; the least busy one counts (a short burst is normal, a full pool is not).
    min_busy=""; cap=""
    for samples in 1 2 3; do
      usage="$(php_threads "$svc" || true)"
      [ -n "$usage" ] || continue
      busy="${usage% *}"; cap="${usage#* }"
      if [ -z "$min_busy" ] || [ "$busy" -lt "$min_busy" ]; then min_busy="$busy"; fi
      [ "$samples" = 3 ] || sleep 1
    done
    knob="$(pool_knob "$svc")"
    if [ -z "$cap" ]; then
      bad "$(pool_label "$svc"): thread usage unavailable ($svc not running?)"; problems=$((problems + 1))
    elif [ "$min_busy" -ge "$cap" ]; then
      bad "$(pool_label "$svc"): all $cap PHP threads busy — requests are queueing. Raise $knob in $ENV_FILE, then falak-ctl up"
      problems=$((problems + 1))
    elif [ $((min_busy * 100)) -ge $((cap * 80)) ]; then
      warn "$(pool_label "$svc"): $min_busy/$cap PHP threads busy (>= 80%) — consider raising $knob"
      problems=$((problems + 1))
    else
      ok "$(pool_label "$svc"): $min_busy/$cap PHP threads busy"
    fi
  done
  legacy="$(legacy_thread_config)"
  if [ -n "$legacy" ]; then
    warn "custom.env: '$legacy' (0.2.x hotfix) overrides the automatic thread sizing — remove the line, then falak-ctl up"
    problems=$((problems + 1))
  fi

  info "Disk & memory"
  local avail
  avail="$(df -Pk "$FALAK_DIR" | awk 'NR==2 {print int($4/1024/1024)}')"
  if [ "${avail:-0}" -lt 5 ]; then bad "only ${avail} GB free on $FALAK_DIR"; problems=$((problems + 1)); else ok "${avail} GB free on $FALAK_DIR"; fi
  if [ -r /proc/meminfo ]; then ok "$(awk '/MemTotal/ {t=$2} /MemAvailable/ {a=$2} END {printf "%.1f GB RAM, %.1f GB available", t/1048576, a/1048576}' /proc/meminfo)"; fi

  info "Backups & disaster recovery"
  local last
  last="$(latest_backup)"
  if [ -z "$last" ]; then warn "no backups yet — run falak-ctl backup (and copy it off this host)"; problems=$((problems + 1))
  else ok "latest local: $(basename "$last")"; fi
  dr_doctor || problems=$((problems + 1))

  say
  if [ "$problems" = 0 ]; then ok "no problems found"; else warn "$problems problem(s) found"; return 1; fi
}

resolve() {
  if command -v dig >/dev/null 2>&1; then
    { dig +short A "$1"; dig +short AAAA "$1"; } 2>/dev/null | grep -E '^[0-9a-fA-F:.]+$' || true
  else
    getent ahosts "$1" 2>/dev/null | awk '{print $1}' | sort -u || true
  fi
}

port_listening() {
  if command -v ss >/dev/null 2>&1; then ss -Hltn "sport = :$1" 2>/dev/null | grep -q .
  else (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
  fi
}

cert_field() { # cert_field HOST -enddate|-issuer
  local port; port="$(https_port)"
  echo | openssl s_client -connect "127.0.0.1:$port" -servername "$1" 2>/dev/null | openssl x509 -noout "$2" 2>/dev/null
}

days_left() { # days_left "Mon DD HH:MM:SS YYYY GMT" MIN_DAYS
  local end_s now_s
  end_s="$(date -d "$1" +%s 2>/dev/null || date -j -f '%b %e %T %Y %Z' "$1" +%s 2>/dev/null || echo 0)"
  now_s="$(date +%s)"
  [ $(( (end_s - now_s) / 86400 )) -ge "$2" ]
}

cmd_domain() {
  require_install
  [ "${1:-}" = "set" ] || die "usage: falak-ctl domain set <new-domain> [--keep-old]"
  shift
  local new="" keep_old=0
  while [ $# -gt 0 ]; do
    case "$1" in --keep-old) keep_old=1 ;; -*) die "unknown option $1" ;; *) new="$1" ;; esac
    shift
  done
  [ -n "$new" ] || die "usage: falak-ctl domain set <new-domain> [--keep-old]"
  local old old_agents port suffix
  old="$(env_get FALAK_DOMAIN)"; old_agents="$(env_get FALAK_AGENT_API_HOST)"
  port="$(https_port)"; suffix=""; [ "$port" != 443 ] && suffix=":$port"
  info "moving the panel from $old to $new"
  cmd_backup --label "pre-domain-change" --quiet
  env_set FALAK_DOMAIN "$new"
  env_set FALAK_URL "https://$new$suffix"
  env_set FALAK_AGENT_API_HOST "agents.$new"
  env_set FALAK_AGENT_API_URL "https://agents.$new$suffix/agent/v1"
  # Enrolled agents keep calling the agent API host they enrolled with: keep serving it.
  local aliases
  aliases="$(env_get FALAK_AGENT_API_HOST_ALIASES)"
  case ",$aliases," in *",$old_agents,"*) ;; *) aliases="${aliases:+$aliases,}$old_agents" ;; esac
  env_set FALAK_AGENT_API_HOST_ALIASES "$aliases"
  if [ "$keep_old" = 1 ]; then env_set FALAK_DOMAIN_ALIASES "$old"; fi
  local old_registry
  old_registry="$(env_get FALAK_REGISTRY_HOST)"
  if [ -n "$old_registry" ]; then
    # Images of earlier releases keep pulling from the old name (served as an alias; keep its DNS record).
    env_set FALAK_REGISTRY_HOST "registry.$new"
    env_set FALAK_REGISTRY_URL "registry.$new$suffix"
    aliases="$(env_get FALAK_REGISTRY_HOST_ALIASES)"
    case ",$aliases," in *",$old_registry,"*) ;; *) aliases="${aliases:+$aliases,}$old_registry" ;; esac
    env_set FALAK_REGISTRY_HOST_ALIASES "$aliases"
  fi
  if [ -n "$(env_get FALAK_GRAFANA_HOST)" ]; then
    env_set FALAK_GRAFANA_HOST "grafana.$new"
    env_set FALAK_GRAFANA_PUBLIC_URL "https://grafana.$new$suffix"
  fi
  [ -n "$(env_get FALAK_OTLP_ENDPOINT)" ] && env_set FALAK_OTLP_ENDPOINT "https://$new$suffix/otlp"
  ensure_registry_env
  wait_healthy 420
  health_check || true
  ok "panel: https://$new$suffix"
  say "  Keep DNS for $old_agents pointing here: enrolled agents still use it (served as an alias)."
  [ -n "$old_registry" ] && say "  Add DNS for registry.$new; keep $old_registry pointing here (images of earlier releases)."
  say "  New servers enroll against https://$new$suffix; update CLI logins (falak login --url ...)."
}

# Panel over Tailscale only: FALAK_PANEL_ALLOW limits the edge's browser paths (deploy/edge/Caddyfile); machine paths
# (agents, installers, API, webhooks, relay, OTLP, /up, status pages) stay public.
PANEL_TAILNET_RANGES="100.64.0.0/10 fd7a:115c:a1e0::/48"
cmd_panel_access() {
  require_install
  local sub="${1:-status}" allow ip
  case "$sub" in
    tailnet)
      if ! ip="$(tailscale ip -4 2>/dev/null | head -1)" || [ -z "$ip" ]; then
        bad "this machine is not on a tailnet (tailscale ip -4 failed): the panel would be unreachable"
        say "  Join it first: Settings → Network → Tailscale (save the auth key), then Servers → the control-plane"
        say "  server → Network → Join the tailnet. Wait until it is active, then run this again."
        exit 1
      fi
      # Devices reach the panel through this machine's advertised route: refuse until it is approved.
      if ! tailscale status --json --peers=false 2>/dev/null | tr -d ' \t\n' | grep -q '"PrimaryRoutes":\["'; then
        bad "this machine's route is not approved yet: tailnet devices would not reach the panel"
        say "  Approve it in the Tailscale admin console (Machines → this machine → Edit route settings), then run this again."
        exit 1
      fi
      env_set FALAK_PANEL_ALLOW "$PANEL_TAILNET_RANGES"
      compose up -d --wait --wait-timeout 120 --no-deps edge >/dev/null || die "recreating the edge failed (falak-ctl logs edge); back to public: falak-ctl panel-access public"
      ok "the panel answers browsers only over the tailnet ($PANEL_TAILNET_RANGES; this machine: $ip)"
      say "  Devices must accept routes (Linux: tailscale set --accept-routes). Agents, webhooks and the API stay public."
      say "  Locked out? Over SSH: falak-ctl panel-access public" ;;
    public)
      env_set FALAK_PANEL_ALLOW ""
      compose up -d --wait --wait-timeout 120 --no-deps edge >/dev/null || die "recreating the edge failed (falak-ctl logs edge)"
      ok "the panel is reachable from anywhere again" ;;
    status)
      allow="$(env_get FALAK_PANEL_ALLOW)"
      case "$allow" in
        "") say "panel access: public" ;;
        "$PANEL_TAILNET_RANGES") say "panel access: tailnet ($allow)" ;;
        *) say "panel access: custom ($allow)" ;;
      esac
      if ip="$(tailscale ip -4 2>/dev/null | head -1)" && [ -n "$ip" ]; then say "  this machine on the tailnet: $ip"; else say "  this machine is not on a tailnet"; fi ;;
    *) die "usage: falak-ctl panel-access tailnet | public | status" ;;
  esac
}

cmd_admin() {
  require_install
  local sub="${1:-}"; shift || true
  case "$sub" in
    reset-password)
      [ -n "${1:-}" ] || die "usage: falak-ctl admin reset-password <email> [--password=...]"
      compose exec -T control-plane php artisan falak:admin "$@" --reset-password ;;
    create)
      [ -n "${1:-}" ] || die "usage: falak-ctl admin create <email> [--organization=...] [--token=name]"
      compose exec -T control-plane php artisan falak:admin "$@" ;;
    *) die "usage: falak-ctl admin reset-password|create <email>" ;;
  esac
}

usage() { sed -n '2,46p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    up) require_install; ensure_registry_env; ensure_kek --quiet; dr_write_json; cmd_ensure_host
        pull_images missing || die "pulling images failed (see above); nothing was started"
        wait_healthy "${1:-420}" && health_check ;;
    down) require_install; compose down ;;
    restart) require_install; compose restart "$@" ;;
    update|upgrade) ctl_lock; cmd_update "$@" ;;
    backup)
      case " $* " in
        *" --scheduled "*) ctl_lock 3600; cmd_backup_scheduled "$@" ;;
        *) ctl_lock; cmd_backup "$@" ;;
      esac ;;
    restore) ctl_lock; cmd_restore "$@" ;;
    doctor) cmd_doctor "$@" ;;
    domain) cmd_domain "$@" ;;
    admin) cmd_admin "$@" ;;
    artisan) require_install; compose exec control-plane php artisan "$@" ;;
    compose) require_install; compose "$@" ;;
    health) require_install; health_check ;;
    reload-configs) require_install; recreate_drifted 300 ;;
    local-server)
      case "${1:-}" in enable|disable) ctl_lock ;; esac
      cmd_local_server "$@" ;;
    panel-access)
      case "${1:-}" in tailnet|public) ctl_lock ;; esac
      cmd_panel_access "$@" ;;
    ensure-host) cmd_ensure_host ;;
    host-run) require_install; cmd_host_run ;;
    host-job) require_install; cmd_host_job "$@" ;;
    registry) cmd_registry "$@" ;;
    prune-images) cmd_prune_images "$@" ;;
    kek) cmd_kek "$@" ;;
    dr)
      case "${1:-} $* " in
        "drill "*" --scheduled "*) ctl_lock 7200 ;;
        "drill "*) ctl_lock ;;
      esac
      cmd_dr "$@" ;;
    version) require_install; env_get FALAK_VERSION; echo ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}

# Sourced by deploy/tests/*.sh for function-level tests.
if [ "${FALAK_CTL_SOURCED:-0}" != 1 ]; then main "$@"; fi
