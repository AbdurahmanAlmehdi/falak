# Falak production edge (proven in sim/edge; differences: ACME for public hosts, no client_auth on the
# panel host, security headers, optional Grafana + OTLP).
#
#   {$FALAK_DOMAIN}         panel, installer (/install/*), enrollment (/agent/v1/enroll), Reverb (/app, /apps),
#                           terminal relay for browsers and the CLI (/terminal/v1/*),
#                           OTLP ingress (/otlp/v1/* -> gateway, observability profile).
#                           TLS: Let's Encrypt (FALAK_TLS=acme) or Caddy's internal CA (FALAK_TLS=internal).
#   {$FALAK_AGENT_API_HOST} agent mTLS API. Agents pin the Falak Fleet CA, so this host is served with a server
#                           certificate issued by the Fleet CA (never ACME); site file generated by the
#                           entrypoint once /falak/ca/agent-api.{pem,key} exist.
#   FALAK_GRAFANA_HOST      optional Grafana (generated site file, observability profile).
#
# Upstreams (both hosts): machine traffic (/agent/*, /install/*, /api/internal/*: agents, the installer and
# builders, including their 30 s long-polls) goes to the agent-api service, everything else to the panel
# (control-plane). Separate FrankenPHP thread pools: a busy fleet can never starve the panel.
#
# Agent auth (contracts/agent-protocol): client certs are verified against the Fleet CA; /agent/v1/* except
# /agent/v1/enroll requires one. The SHA-256 of the client DER cert is forwarded as
# X-Falak-Client-Cert-Fingerprint; any client-supplied value of that header is always stripped.
{
	admin localhost:2019
	email {$FALAK_ACME_EMAIL}
	http_port {$FALAK_HTTP_PORT:80}
	https_port {$FALAK_HTTPS_PORT:443}
	import /etc/caddy/global/*.caddyfile
	servers {
		protocols h1 h2 h3
	}
	log {
		output stdout
		format json
		level {$FALAK_EDGE_LOG_LEVEL:INFO}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "{$FALAK_HSTS:max-age=31536000}"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		# Baseline for responses without a policy of their own (Grafana, Horizon, files). Panel pages send their
		# full nonce-based policy from the control plane (HandleInertiaRequests), which this never replaces.
		?Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
		-Server
		-X-Powered-By
	}
}

(client_auth_fleet) {
	client_auth {
		mode verify_if_given
		trust_pool file {
			pem_file /etc/caddy/trust/ca.pem
		}
	}
}

(falak_routes) {
	@agent_without_cert {
		path /agent/v1/*
		not path /agent/v1/enroll
		# No client cert presented (the DER placeholder is empty without one).
		vars {http.request.tls.client.certificate_der_base64} ""
	}
	@with_cert not vars {http.request.tls.client.certificate_der_base64} ""
	@reverb path /app/* /apps/*
	# Terminal relay (docs/plans/CONSOLE.md): agents attach with their client cert, browsers and the CLI with a
	# single-use ticket the panel signs.
	@relay_agent {
		path /agent/v1/relay/*
		not vars {http.request.tls.client.certificate_der_base64} ""
	}
	@relay_client path /terminal/v1/*
	@machine_with_cert {
		path /agent/* /install/* /api/internal/*
		not vars {http.request.tls.client.certificate_der_base64} ""
	}
	@machine path /agent/* /install/* /api/internal/*
	# Panel over Tailscale only (falak-ctl panel-access tailnet): browser paths answer 403 outside FALAK_PANEL_ALLOW
	# (space-separated CIDRs; unset: everyone). Machine paths stay public: agents, installers and builders, the token
	# API with webhooks and deploy hooks (/api/*), the terminal relay (CLI), OTLP, health and public status pages.
	# No trusted_proxies on this edge, so client_ip is the TCP peer (a client-sent X-Forwarded-For / CF-Connecting-IP
	# changes nothing).
	@panel_denied {
		not path /agent/* /install/* /api/* /otlp/* /terminal/v1/* /up /status/*
		not client_ip {$FALAK_PANEL_ALLOW:0.0.0.0/0 ::/0}
	}

	route {
		respond @panel_denied "This panel is only reachable over the organization's Tailscale network." 403
		respond @agent_without_cert `{"message":"client certificate required"}` 401

		handle @reverb {
			reverse_proxy reverb:8080
		}
		handle @relay_agent {
			reverse_proxy relay:8080 {
				header_up X-Falak-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
			}
		}
		handle @relay_client {
			reverse_proxy relay:8080 {
				header_up -X-Falak-Client-Cert-Fingerprint
			}
		}
		handle @machine_with_cert {
			reverse_proxy agent-api:8080 {
				header_up X-Falak-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
			}
		}
		handle @machine {
			reverse_proxy agent-api:8080 {
				header_up -X-Falak-Client-Cert-Fingerprint
			}
		}
		handle @with_cert {
			reverse_proxy control-plane:8080 {
				header_up X-Falak-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
			}
		}
		handle {
			reverse_proxy control-plane:8080 {
				header_up -X-Falak-Client-Cert-Fingerprint
			}
		}
	}
}

{$FALAK_DOMAIN} {
	import security_headers
	log
	# OTLP/HTTP ingress for agents (observability profile): https://<domain>/otlp/v1/{traces,metrics,logs}.
	handle_path /otlp/* {
		reverse_proxy gateway:4318
	}
	handle {
		import falak_routes
	}
}

import /etc/caddy/sites/*.caddyfile

# Operator-owned sites from /opt/falak/edge (mounted read-only; empty unless the operator adds files).
import /etc/caddy/custom/*.caddyfile
