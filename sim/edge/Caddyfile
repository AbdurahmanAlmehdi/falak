# Sim edge for the Falak control plane.
#
#   falak.test (+ localhost)  panel, installer, enrollment. TLS from Caddy's internal CA
#                             (published to /falak/edge-pki/root.crt and trusted by the sim servers).
#   agents.falak.test         agent mTLS API. TLS server cert issued by the Falak Fleet CA
#                             (agents pin it); site added by the entrypoint once
#                             /falak/ca/agent-api.{pem,key} exist (see sites/ below).
#
# Agent auth per contracts/agent-protocol: client certs are verified against the Fleet CA
# (/falak/ca/ca.pem -> /etc/caddy/trust/ca.pem). /agent/v1/* except /agent/v1/enroll requires a
# cert. The SHA-256 (lowercase hex) of the client DER cert is forwarded as
# X-Falak-Client-Cert-Fingerprint. Any client-supplied value of that header is always stripped.
{
	admin localhost:2019
	skip_install_trust
	pki {
		ca local {
			name "Falak Sim Edge CA"
		}
	}
}

(client_auth_fleet) {
	client_auth {
		mode verify_if_given
		trust_pool file {
			pem_file /etc/caddy/trust/ca.pem
		}
	}
}

(falak_routes) {
	@agent_without_cert {
		path /agent/v1/*
		not path /agent/v1/enroll
		# No client cert presented. (Caddy reports sha256("") as the fingerprint when there is no
		# cert, so presence is keyed on the DER placeholder, which is empty without one.)
		vars {http.request.tls.client.certificate_der_base64} ""
	}
	@with_cert not vars {http.request.tls.client.certificate_der_base64} ""
	@reverb path /app/* /apps/*
	# Terminal relay (same as deploy/edge/Caddyfile): agents with their client cert, browsers/the CLI with a ticket.
	@relay_agent {
		path /agent/v1/relay/*
		not vars {http.request.tls.client.certificate_der_base64} ""
	}
	@relay_client path /terminal/v1/*
	# Machine traffic (agents, installer, builders; long-polls) -> agent-api, its own FrankenPHP thread pool
	# (same split as deploy/edge/Caddyfile).
	@machine_with_cert {
		path /agent/* /install/* /api/internal/*
		not vars {http.request.tls.client.certificate_der_base64} ""
	}
	@machine path /agent/* /install/* /api/internal/*

	route {
		respond @agent_without_cert `{"message":"client certificate required"}` 401

		# Debug helper for agent developers: shows what the edge forwards.
		respond /_edge/whoami `{"fingerprint":"{http.request.tls.client.fingerprint}","subject":"{http.request.tls.client.subject}"}` 200

		handle @reverb {
			reverse_proxy reverb:8080
		}
		handle @relay_agent {
			reverse_proxy relay:8080 {
				header_up X-Falak-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
			}
		}
		handle @relay_client {
			reverse_proxy relay:8080 {
				header_up -X-Falak-Client-Cert-Fingerprint
			}
		}
		handle @machine_with_cert {
			reverse_proxy agent-api:8080 {
				header_up X-Falak-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
			}
		}
		handle @machine {
			reverse_proxy agent-api:8080 {
				header_up -X-Falak-Client-Cert-Fingerprint
			}
		}
		handle @with_cert {
			reverse_proxy control-plane:8080 {
				header_up X-Falak-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
			}
		}
		handle {
			reverse_proxy control-plane:8080 {
				header_up -X-Falak-Client-Cert-Fingerprint
			}
		}
	}
}

falak.test, localhost, edge {
	tls internal {
		import client_auth_fleet
	}
	import falak_routes
}

# Sim caches (compose.yml, `make clean-cache`), TLS from the same internal CA the servers trust:
#   downloads.falak.test        runtime release mirror (FALAK_*_MIRROR) -> sim-downloads (caching nginx)
#   ppa.launchpadcontent.net    resolve to the edge only on the servers (compose extra_hosts): the ondrej/php
#   ghcr.io                     PPA and GHCR, served through pull-through caches of the real upstreams.
downloads.falak.test, ppa.launchpadcontent.net {
	tls internal
	reverse_proxy sim-downloads:80
}

ghcr.io {
	tls internal
	reverse_proxy sim-ghcr-mirror:5000
}

import sites/*.caddyfile
