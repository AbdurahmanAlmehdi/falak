{
  "uid": "falak-node",
  "title": "Falak / Node app",
  "description": "@othmanhaba/apm-node: HTTP span metrics + Node runtime metrics (OTel nodejs.* / v8js.* conventions).",
  "tags": [
    "falak",
    "node",
    "site"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "falak-metrics"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{falak_event_type=\"request\"}, falak_site_id)",
          "refId": "site-var"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{falak_event_type=\"request\"}, falak_site_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deployments (control plane)",
        "enable": true,
        "iconColor": "#8e44ff",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "falak",
            "deployment"
          ],
          "limit": 200,
          "matchAny": false
        }
      },
      {
        "name": "Deployments (agent logs)",
        "enable": true,
        "iconColor": "#ff9830",
        "datasource": {
          "type": "loki",
          "uid": "falak-loki"
        },
        "expr": "{service_name=\"falak-agent\"} | falak_event_type=\"deployment\" | falak_site_id=~\"${site:regex}\"",
        "titleFormat": "Deploy {{falak_deployment_status}}",
        "textFormat": "{{falak_deployment_id}}",
        "tagKeys": "falak_deployment_status,falak_site_id"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "falak"
      ],
      "asDropdown": true,
      "title": "Falak",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{falak_site_id=~\"$site\",falak_event_type=\"request\"}[5m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{falak_site_id=~\"$site\",falak_event_type=\"request\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(traces_spanmetrics_calls_total{falak_site_id=~\"$site\",falak_event_type=\"request\"}[5m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
