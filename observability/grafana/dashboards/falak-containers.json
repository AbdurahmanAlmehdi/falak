        "query": {
          "query": "label_values(falak_workload_memory_usage_bytes{host_name=~\"$host\"}, service_name)",
          "refId": "service-var"
        },
        "definition": "label_values(falak_workload_memory_usage_bytes{host_name=~\"$host\"}, service_name)",
