    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "falak-metrics"
        },
        "query": {
          "query": "label_values(falak_workload_memory_usage_bytes, host_name)",
          "refId": "host-var"
        },
        "definition": "label_values(falak_workload_memory_usage_bytes, host_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {},
        "hide": 0
