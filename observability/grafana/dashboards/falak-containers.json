          "type": "prometheus",
          "uid": "falak-metrics"
        },
        "query": {
          "query": "label_values(falak_workload_memory_usage_bytes{host_name=~\"$host\", service_name=~\"$service\"}, falak_workload_kind)",
          "refId": "kind-var"
        },
        "definition": "label_values(falak_workload_memory_usage_bytes{host_name=~\"$host\", service_name=~\"$service\"}, falak_workload_kind)",
