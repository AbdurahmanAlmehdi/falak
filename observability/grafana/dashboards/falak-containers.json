{
  "uid": "falak-containers",
  "title": "Falak / Workloads",
  "description": "Per-workload CPU, memory, I/O and processes from cgroup v2 and /proc (falak-agent): site containers, database containers, native sites (slice or unix user) and worker / daemon slices, against their limits.",
  "tags": [
    "falak",
    "workloads",
    "containers"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
