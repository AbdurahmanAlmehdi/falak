        "query": {
          "query": "label_values(falak_workload_memory_usage_bytes{host_name=~\"$host\", service_name=~\"$service\", falak_workload_kind=~\"$kind\"}, falak_workload_name)",
          "refId": "workload-var"
        },
        "definition": "label_values(falak_workload_memory_usage_bytes{host_name=~\"$host\", service_name=~\"$service\", falak_workload_kind=~\"$kind\"}, falak_workload_name)",
        "refresh": 2,
        "sort": 1,
