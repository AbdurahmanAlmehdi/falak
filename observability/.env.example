# Copy to .env and adjust. All values shown are the defaults.

# --- metrics backend -------------------------------------------------------------
# Choose ONE profile: victoriametrics (default, lighter) or mimir.
# Setting this lets you run plain `docker compose up -d` (instead of passing --profile).
# COMPOSE_PROFILES=victoriametrics
# Grafana datasource. The gateway auto-routes to whichever backend is running, so the
# default works for both. "Mimir" enables Mimir-specific features in the datasource.
FALAK_METRICS_QUERY_URL=http://gateway:9090/prometheus
FALAK_METRICS_PROMETHEUS_TYPE=Prometheus   # Prometheus | Mimir

# --- retention -------------------------------------------------------------------
FALAK_LOGS_RETENTION=360h     # Loki   (15d)
FALAK_TRACES_RETENTION=360h   # Tempo  (15d)
FALAK_METRICS_RETENTION=30d   # VictoriaMetrics / Mimir

# --- ingress ---------------------------------------------------------------------
# 127.0.0.1 by default; 0.0.0.0 to take OTLP from other hosts (then use a strong token, and TLS in front).
FALAK_OTLP_BIND=127.0.0.1
FALAK_OTLP_PORT=4318
# Required: agents must send "Authorization: Bearer <token>" to :4318/v1/* (openssl rand -hex 24).
# Without one every /v1/* request gets 401, unless FALAK_OTLP_ALLOW_ANONYMOUS=1.
FALAK_OTLP_TOKEN=
FALAK_OTLP_ALLOW_ANONYMOUS=0

# --- grafana ---------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Required (compose refuses to start without it): openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3000
FALAK_GRAFANA_BIND=127.0.0.1
FALAK_GRAFANA_PORT=3000

# --- loopback-only query ports (smoke test / debugging) ----------------------------
FALAK_LOKI_PORT=3100
FALAK_TEMPO_PORT=3200
FALAK_METRICS_QUERY_PORT=9090
